---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { copy, langOf, otherPath } from "../lib/i18n";

interface Props {
  title: string;
  description?: string;
  /** Long article pages show a thin reading-progress bar under the header. */
  progress?: boolean;
  /** The home page ends with its own contact and footer block, so it leaves this footer out. */
  footer?: boolean;
}

// The page's language follows its path (/sl/ is Slovenian).
const lang = langOf(Astro.url.pathname);
const {
  title,
  description = copy(lang).meta.description,
  progress = false,
  footer = true,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const other = new URL(otherPath(Astro.url.pathname), Astro.site);
// The picture shown when the link is shared (public/og.png, 1200 x 630).
const shareImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Kristjan Mihin</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} | Kristjan Mihin`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "sl" ? "sl_SI" : "en_GB"} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={lang === "sl" ? "en" : "sl"} href={other} />
    <meta name="theme-color" content="#f6f0e5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
    <script is:inline>
      // Mark the document before first paint so motion start states apply only when JS runs.
      document.documentElement.classList.add("js");
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("reduce-motion");
    </script>
  </head>
  <body class="min-h-dvh flex flex-col">
    <!-- Kept across client navigation: the sculptures carry on, and the veil a case study opens out of (entrance.ts) stays over the swap. -->
    <canvas id="sculptures" aria-hidden="true" transition:persist="sculptures"></canvas>
    <div id="veil" aria-hidden="true" transition:persist="veil"></div>
    <Header lang={lang} />
    {progress && <div id="progress" class="fixed top-0 inset-x-0 z-30 h-0.5 bg-ink origin-left" aria-hidden="true"></div>}
    <main class="flex-1 w-full">
      <slot />
    </main>
    {footer && <Footer lang={lang} />}
  </body>
</html>

<script>
  // Start the motion layer on first load and after every client-side navigation;
  // tear it down before the DOM is swapped so nothing animates a dead page.
  import { startMotion, stopMotion } from "../scripts/motion";

  document.addEventListener("astro:page-load", startMotion);
  document.addEventListener("astro:before-swap", (event) => {
    stopMotion();
    // Carry the pre-paint flags over to the incoming document so start states apply there too.
    const next = (event as any).newDocument.documentElement as HTMLElement;
    next.classList.add("js");
    if (document.documentElement.classList.contains("reduce-motion")) next.classList.add("reduce-motion");
  });
</script>
