---
// The whole site is this one page: hero, about, facts, work, expertise, what I offer, closing
// statement and contact. The page is ivory paper with one midnight navy band (Tech expertise) in the
// middle, a brass seam where the material changes. Each chapter has its own background
// (public/backgrounds/, classes in global.css), faded at its edges so one flows into the next.
// The particle cloud forms the scene of each item throughout.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Facts from "../components/Facts.astro";
import Showcase from "../components/Showcase.astro";
import type { Item } from "../components/Showcase.astro";
import Seam from "../components/Seam.astro";
import Closing from "../components/Closing.astro";
import Contact from "../components/Contact.astro";

const byId = (a: any, b: any) => a.data.id.localeCompare(b.data.id);
// Featured studies first, then the most recently active ("2022-2026" counts as 2026).
const lastYear = (w: any) => String(w.data.year).split("-").pop() ?? "";
const byFeaturedThenYear = (a: any, b: any) => Number(b.data.featured) - Number(a.data.featured) || lastYear(b).localeCompare(lastYear(a));
const skills = (await getCollection("skills")).sort(byId);
const services = (await getCollection("services")).sort(byId);
const work = [...(await getCollection("professional")).sort(byFeaturedThenYear), ...(await getCollection("projects")).sort(byFeaturedThenYear)];

// Particle scene for each case study: what it was and what it became, shown side by side.
const workScenes: Record<string, string> = {
  "azure-migration": "server+cloud",
  "document-platform": "document+signed",
  "rebac-authorization": "lock+key",
  mojbeach: "ball+calendar",
  "fuel-guide": "dumbbell+phone",
  "stekner-house": "house+browser",
};

const skillItems: Item[] = skills.map((s) => ({ label: s.data.title, title: s.data.title, text: s.data.text, shapes: s.data.shape }));

const workItems: Item[] = work.map((w) => ({
  label: w.data.label ?? w.data.title,
  title: w.data.title,
  text: w.data.summary,
  facts: [
    { label: w.data.type === "project" ? "Side project" : "Professional", value: w.data.year },
    { label: "Role", value: w.data.role.split(".")[0] },
    { label: "Stack", value: w.data.stack.slice(0, 4).join(", ") },
  ],
  link: w.data.links.live
    ? { href: w.data.links.live, label: "Live site" }
    : w.data.links.repo
      ? { href: w.data.links.repo, label: "Source on GitHub" }
      : { href: `/work/${w.data.slug}`, label: "Full case study" },
  shapes: workScenes[w.data.slug] ?? "document",
}));

const serviceItems: Item[] = services.map((s) => ({ label: s.data.title, title: s.data.title, text: s.data.text, shapes: s.data.shape }));

const about = [
  "I'm a full-stack developer with 5+ years of experience in modern web applications, cloud infrastructure and system integrations.",
  "I care about security as much as features: who can see and change what, roles and rights between companies, and data that moves safely between systems.",
  "I enjoy solving complex problems, working with new technologies and building solutions that make a real difference.",
];

const values = [
  { icon: "code" as const, label: "Clean code, best practices" },
  { icon: "lock" as const, label: "Security, roles & rights" },
  { icon: "cloud" as const, label: "Azure & DevOps" },
  { icon: "chart" as const, label: "Continuous improvement" },
];

const facts = [
  { value: "4+", label: "years building production software" },
  { value: "10k+", label: "documents a year through a platform I designed" },
  { value: "10+", label: "servers migrated to Azure" },
  { value: "2", label: "own products live" },
];
---

<Base title="Full-stack developer" footer={false}>
  <Hero
    role="Full-stack developer"
    first="Kristjan"
    last="Mihin"
    tagline="Building business web applications, integrating systems and running reliable cloud infrastructure on .NET and Azure."
    stack={[".NET", "Azure", "TypeScript", "React", "SQL"]}
  />
  <About paragraphs={about} values={values} />
  <Facts facts={facts} />

  <Showcase
    id="work"
    number="02"
    theme="ivory"
    title="Selected"
    titleEm="Work"
    lead="Systems built in employment, described without client names, and products of my own with public code."
    background="bg-projects"
    items={workItems}
    interval={7}
  />

  <Seam theme="ivory" />

  <Showcase
    id="skills"
    number="03"
    theme="ivory"
    title="Tech"
    titleEm="Expertise"
    lead="The stack I work in every day, and what I have actually done with it."
    background="bg-tech"
    items={skillItems}
    interval={6}
  />

  <Seam theme="ivory" />

  <Showcase
    id="offer"
    number="04"
    theme="ivory"
    title="What I"
    titleEm="Offer"
    lead="From a focused integration to a complete system. Scope, availability and rates are agreed per project."
    background="bg-services"
    items={serviceItems}
    interval={6}
    compact
  />

  <Closing />
  <Contact />
</Base>
