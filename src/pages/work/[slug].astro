---
// A case study page in English.
import CaseStudy from "../../components/CaseStudy.astro";
import { workOf } from "../../lib/content";

export async function getStaticPaths() {
  const work = await workOf("en");
  return work.map((entry, i) => ({
    params: { slug: entry.data.slug },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}
const { entry, next } = Astro.props;
---

<CaseStudy lang="en" entry={entry} next={next} />
