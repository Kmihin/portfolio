---
// The opening room: the name large on the left (the surname in brass italic), one line on what I do,
// "View my work" and "About me", the main stack on a brass line; on the right the armillary
// sphere, a globe in brass rings (sculptures.ts). On phones the sculpture stands above the name.
import type { Copy } from "../lib/i18n";

interface Props {
  copy: Copy["hero"];
  first: string;
  last: string;
}
const { copy, first, last } = Astro.props;
---

<section id="home" class="room section-bg bg-hero relative" data-theme="ivory">
  <div class="wrap room-grid hero-grid">
    <div class="hero-slot" data-sculpture="armillary" aria-hidden="true"></div>
    <div class="hero-copy" data-enter>
      <p class="eyebrow">{copy.role}</p>
      <h1 class="hero-name mt-5 lg:mt-7">
        <span class="block">{first}</span>
        <em class="block text-accent">{last}</em>
      </h1>
      <p class="mt-6 lg:mt-8 text-base sm:text-lg leading-relaxed max-w-[38ch]">{copy.tagline}</p>
      <div class="mt-8 lg:mt-10 flex flex-wrap items-center gap-x-10 gap-y-4">
        <a href="#work" class="btn btn-primary">{copy.viewWork} <span class="arrow" aria-hidden="true">&rarr;</span></a>
        <a href="#about" class="link text-sm py-1">{copy.aboutMe}</a>
      </div>
      <ul class="stack-list mt-12" aria-label={copy.stackLabel}>
        {copy.stack.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    min-height: 100dvh;
    align-items: center;
    padding-top: 5rem;
    padding-bottom: 3rem;
  }
  .hero-slot {
    height: 44dvh;
  }
  .hero-name {
    font-size: clamp(3.75rem, 8.6vw, 9.5rem);
    font-weight: 600;
    line-height: 0.96;
    letter-spacing: -0.015em;
  }
  .hero-name em {
    font-weight: 600;
  }
  /* The main stack: small spaced capitals in a row, on a brass line. */
  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--accent);
    max-width: 30rem;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
    .hero-copy {
      grid-row: 1;
      grid-column: 1;
    }
    .hero-slot {
      grid-row: 1;
      grid-column: 2;
      height: min(78dvh, 46vw);
    }
  }
</style>
