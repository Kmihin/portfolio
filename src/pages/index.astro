---
// The whole site is this one page: intro, expertise, work, what I offer, closing statement and contact.
// Each part after the intro is a pinned Story where the particle cloud forms the scene of each step.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Intro from "../components/Intro.astro";
import Story from "../components/Story.astro";
import type { Step } from "../components/Story.astro";
import Closing from "../components/Closing.astro";

const [profile] = await getCollection("profile");
const p = profile.data;

const byId = (a: any, b: any) => a.data.id.localeCompare(b.data.id);
const byYear = (a: any, b: any) => b.data.year.localeCompare(a.data.year);
const skills = (await getCollection("skills")).sort(byId);
const services = (await getCollection("services")).sort(byId);
// Too specific for the page: the carrier import stays as content but is not shown here.
const hidden = ["carrier-data-import"];
const work = [...(await getCollection("professional")).sort(byYear), ...(await getCollection("projects")).sort(byYear)].filter(
  (w) => !hidden.includes(w.data.slug)
);

// Particle scene for each case study: what it was, and what it became.
const workScenes: Record<string, string> = {
  "azure-migration": "server>cloud",
  "ecmr-platform": "document>signed",
  "rebac-authorization": "lock>key",
  "carrier-data-import": "rows>database",
  mojbeach: "ball>calendar",
  "fuel-guide": "dumbbell>phone",
  "stekner-house": "house>browser",
};

const skillSteps: Step[] = skills.map((s) => ({ title: s.data.title, text: s.data.text, shapes: s.data.shape }));

const workSteps: Step[] = work.map((w) => ({
  title: w.data.title,
  text: w.data.summary,
  meta: `${w.data.type === "project" ? "Side project" : "Professional"}, ${w.data.year}. ${w.data.stack.slice(0, 5).join(", ")}.`,
  link: w.data.links.live
    ? { href: w.data.links.live, label: "Live site" }
    : w.data.links.repo
      ? { href: w.data.links.repo, label: "Source on GitHub" }
      : { href: `/work/${w.data.slug}`, label: "Full case study" },
  shapes: workScenes[w.data.slug] ?? "document",
}));

const serviceSteps: Step[] = services.map((s) => ({ title: s.data.title, text: s.data.text, shapes: s.data.shape }));

const facts = [
  { value: "4+", label: "years building production software" },
  { value: "10k+", label: "documents a year through a platform I designed" },
  { value: "10+", label: "servers migrated to Azure" },
  { value: "2", label: "own products live" },
];
---

<Base title="Full-stack developer">
  <Intro
    name={p.name}
    tagline="Full-stack developer. I build web applications, integrations and cloud infrastructure on .NET and Azure."
    statement="Business-critical systems, owned end to end: data model, backend, interface, deployment, support."
    statementDetail=".NET and Azure in production since 2022. React and Supabase for my own products. Available for freelance work in English or Slovenian."
    facts={facts}
  />

  <Story
    id="skills"
    theme="beige"
    title="Expertise"
    lead="The stack I work in every day, and what I have actually done with it."
    titleShape="ring"
    steps={skillSteps}
  />

  <Story
    id="work"
    theme="plum"
    title="Work"
    lead="Systems built in employment, described without client names, and products of my own with public code."
    titleShape="wave"
    titleCloud="center"
    steps={workSteps}
  />

  <Story
    id="offer"
    theme="beige"
    title="What I offer"
    lead="From a focused integration to a complete system. Scope, availability and rates are agreed per project."
    titleShape="sphere"
    steps={serviceSteps}
  />

  <Closing />
</Base>
