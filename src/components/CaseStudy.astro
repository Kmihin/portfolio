---
// A case study page: the header with the study's sculpture beside it, the main image, the features,
// the facts beside the text, and the next study. The same page in English (work/[slug].astro) and
// Slovenian (sl/work/[slug].astro).
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import CaseFeatures from "./CaseFeatures.astro";
import { copy, homePath, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  entry: any;
  next: any;
}
const { lang, entry, next } = Astro.props;
const c = copy(lang);
const home = homePath(lang);
const d = entry.data;
const { Content } = await render(entry);
const label = d.type === "project" ? c.showcase.project : c.showcase.professional;
---


<Base title={d.title} description={d.summary} progress>
  <article class="wrap pt-28 sm:pt-36" data-theme="ivory">
    <a href={`${home}#work`} class="link text-sm text-muted">{c.case.allWork}</a>

    <!-- The header with the study's sculpture beside it (sculptures.ts), the same as in the work room. -->
    <div class="case-head mt-10">
      <header class="max-w-4xl" data-enter>
        <p class="text-sm text-muted">{label}, {d.year}</p>
        <h1 class="mt-3 text-5xl sm:text-7xl leading-[1.02]" data-split>{d.title}</h1>
        {d.tagline && <p class="mt-4 font-display italic text-2xl sm:text-3xl text-accent">{d.tagline}</p>}
        <p class="mt-6 text-lg sm:text-xl text-muted leading-relaxed max-w-[58ch]">{d.summary}</p>
      </header>
      <div class="case-slot" data-sculpture={d.slug} aria-hidden="true"></div>
    </div>

    {
      d.cover && (
        <img
          src={d.cover.src}
          alt={d.cover.alt}
          width={d.cover.width}
          height={d.cover.height}
          fetchpriority="high"
          class="cover mt-12 sm:mt-16"
        />
      )
    }

    {d.features.length > 0 && <CaseFeatures title={c.case.features} features={d.features} note={d.featuresNote} />}

    <div class="mt-14 sm:mt-20 grid gap-12 lg:grid-cols-12">
      <!-- Sticky facts column -->
      <aside class="reveal lg:col-span-4 lg:sticky lg:top-28 lg:self-start">
        <dl class="grid gap-6 sm:grid-cols-2 lg:grid-cols-1 border-t border-accent pt-6">
          <div>
            <dt class="text-sm text-muted">{c.showcase.role}</dt>
            <dd class="mt-1 leading-relaxed">{d.role}</dd>
          </div>
          <div>
            <dt class="text-sm text-muted">{c.showcase.stack}</dt>
            <dd class="mt-1 leading-relaxed">{d.stack.join(", ")}</dd>
          </div>
          {
            (d.links.repo || d.links.live) && (
              <div>
                <dt class="text-sm text-muted">{c.case.links}</dt>
                <dd class="mt-1 flex flex-col gap-1">
                  {d.links.live && (
                    <span>
                      <a href={d.links.live} class="link" rel="noopener">
                        {d.links.liveLabel ?? c.showcase.liveSite}
                      </a>
                      {d.links.liveNote && <span class="block mt-1 text-xs text-muted">{d.links.liveNote}</span>}
                    </span>
                  )}
                  {d.links.repo && <a href={d.links.repo} class="link self-start" rel="noopener">{c.showcase.source}</a>}
                </dd>
              </div>
            )
          }
        </dl>
      </aside>

      <div class="reveal prose-basic lg:col-span-7 lg:col-start-6 max-w-[64ch]">
        <Content />
      </div>
    </div>
  </article>

  <!-- Next case study -->
  <a href={`${home}work/${next.data.slug}`} class="next-link block mt-28 sm:mt-40" data-theme="midnight">
    <div class="wrap py-14 sm:py-20 grid gap-4 sm:grid-cols-12 sm:items-end">
      <p class="text-sm text-muted sm:col-span-3">{c.case.next}</p>
      <h2 class="text-4xl sm:text-6xl leading-[1.05] sm:col-span-8" data-split>{next.data.title}</h2>
      <span class="hidden sm:block text-3xl sm:col-span-1 sm:text-right" aria-hidden="true"><span class="arrow">&rarr;</span></span>
    </div>
  </a>
</Base>

<style>
  .case-head {
    display: grid;
    gap: 2rem;
  }
  .case-slot {
    height: 36dvh;
  }
  @media (min-width: 1024px) {
    .case-head {
      grid-template-columns: 1.4fr 1fr;
      align-items: center;
    }
    .case-slot {
      height: min(52dvh, 32vw);
    }
  }

  /* The main image: full content width, its own proportions, a hairline frame. */
  .cover {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }
  /* Always velvet, whatever the page colour is at the moment it scrolls in. */
  .next-link {
    background-color: var(--midnight-deep);
    color: #f1eadb;
    border-top: 1px solid var(--brass);
    transition: background-color var(--duration-base) ease;
  }
  .next-link .text-muted {
    color: #a7a9b4;
  }
  @media (hover: hover) and (pointer: fine) {
    .next-link:hover {
      background-color: var(--midnight);
    }
  }
</style>
