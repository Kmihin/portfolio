---
// The opening screen. The name across the top, large: while the 3D scene runs it draws the name
// itself into its background (scene.ts), behind the chip;
// the h1 here then only keeps the layout and stays transparent (html.scene-on). Below: one line of
// what I do, the two buttons, and a short note on the model.
// Without the scene the h1 is shown and rises letter by letter (motion.ts, openPage).
interface Props {
  first: string;
  last: string;
  tagline: string;
}
const { first, last, tagline } = Astro.props;
---

<section id="home" class="hero" data-stop="hero">
  <div class="wrap hero-inner">
    <h1 id="hero-name" class="hero-name">
      <!-- data-color: the colour scene.ts draws each line in (the same as the CSS gives it). -->
      <span class="block" data-color="#16181d">{first}</span>
      <span class="block" data-color="#16181d">{last}</span>
    </h1>
    <div class="stage hero-stage" data-stage="hero" aria-hidden="true"></div>
    <!-- Without WebGL: a still of the model, rendered in Blender (html.no-scene). -->
    <img src="/models/chip-still.webp" alt="" width="1500" height="1000" class="hero-still" />
    <div class="hero-foot">
      <div class="hero-pitch">
        <p class="hero-tagline" data-enter>{tagline}</p>
        <div class="flex flex-wrap items-center gap-3" data-enter>
          <a href="/#work" class="btn btn-primary">View work <span class="arrow" aria-hidden="true">&rarr;</span></a>
          <a href="/#contact" class="btn btn-secondary">Get in touch</a>
        </div>
      </div>
      <p class="hero-note label" data-enter>Every layer of the stack</p>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100dvh;
    display: flex;
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    padding-top: 6.5rem;
    padding-bottom: 2.25rem;
  }
  .hero-name {
    font-weight: 800;
    font-size: clamp(3.5rem, 17vw, 15rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
  }
  :global(html.scene-on) .hero-name {
    color: transparent;
    opacity: 1;
  }
  .hero-still {
    display: none;
  }
  :global(html.no-scene) .hero-still {
    display: block;
    width: 100%;
    max-width: 44rem;
    margin: 2rem 0 0 auto;
    border-radius: var(--radius-panel);
  }
  .hero-stage {
    flex: 1;
    min-height: 34dvh;
  }
  .hero-foot {
    display: grid;
    gap: 2rem;
    margin-top: auto;
  }
  .hero-pitch {
    display: grid;
    gap: 1.6rem;
  }
  .hero-tagline {
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    font-weight: 500;
    line-height: 1.4;
    max-width: 32ch;
    text-wrap: balance;
  }
  @media (min-width: 1024px) {
    .hero-inner {
      justify-content: space-between;
      padding-bottom: 3rem;
    }
    .hero-name {
      font-size: min(13.2vw, 27dvh);
    }
    .hero-foot {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
</style>
