---
// Footer of the other pages: name, place, links and the year as monospace labels on a hairline.
import { getCollection } from "astro:content";
const [profile] = await getCollection("profile");
const p = profile.data;
const year = new Date().getFullYear();
---

<footer class="mt-24 sm:mt-32">
  <div class="wrap border-t border-line py-10 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-4 text-sm">
    <div>
      <p class="font-medium">{p.name}</p>
      <p class="mt-1 label">{p.location}</p>
    </div>
    <ul class="flex flex-wrap gap-x-8 gap-y-2">
      <li><a href={`mailto:${p.email}`} class="link">{p.email}</a></li>
      <li><a href={p.github} class="link" rel="noopener">GitHub</a></li>
      <li><a href={p.linkedin} class="link" rel="noopener">LinkedIn</a></li>
    </ul>
    <p class="label">{year}</p>
  </div>
</footer>
