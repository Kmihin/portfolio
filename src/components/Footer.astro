---
// Footer of the case study pages: name and place, contact links, the year.
import { getCollection } from "astro:content";
const [profile] = await getCollection("profile");
const p = profile.data;
const year = new Date().getFullYear();
---

<footer class="site-footer mt-24 lg:mt-32">
  <div class="wrap border-t border-line py-10 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-4">
    <div>
      <p class="font-semibold">{p.name}</p>
      <p class="mt-1 text-sm text-muted">{p.location}</p>
    </div>
    <ul class="flex flex-wrap gap-x-8 gap-y-2 text-sm">
      <li><a href={`mailto:${p.email}`} class="link">{p.email}</a></li>
      <li><a href={p.github} class="link" rel="noopener">GitHub</a></li>
      <li><a href={p.linkedin} class="link" rel="noopener">LinkedIn</a></li>
    </ul>
    <p class="text-sm text-muted">{year}</p>
  </div>
</footer>
