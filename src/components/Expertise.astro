---
// Expertise. On wide screens the list sits on the right and the model on the left, the chip seen
// from the side with its layers apart; the skill crossing the middle of the screen sits on a pane
// of liquid glass (motion.ts, followSpotlight).
interface Props {
  items: { id: string; title: string; text: string }[];
}
const { items } = Astro.props;
---

<section id="skills" class="section" data-stop="skills">
  <div class="wrap">
    <div class="skills-column">
      <h2 class="heading" data-split>What I work with</h2>
      <div class="stage" data-stage="skills" aria-hidden="true"></div>
      <ul class="skills-list" data-spot-list>
        {
          items.map((item) => (
            <li class="skill" data-spot>
              <h3 class="heading-sm">{item.title}</h3>
              <p class="mt-3 text-muted leading-relaxed max-w-[46ch]">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .skills-list {
    margin-top: 1.5rem;
  }
  /* The pane reaches a little past the text on both sides (less than the page margin). */
  .skill {
    padding: 1.5rem 1rem;
    margin-inline: -1rem;
    border-radius: var(--radius-panel);
    box-shadow: inset 0 0 0 1px transparent;
    transition:
      opacity 500ms ease,
      background-color 500ms ease,
      box-shadow 500ms ease;
  }
  /* Only with JS and motion: without them every skill is simply shown in full. */
  :global(html.js:not(.reduce-motion)) .skill {
    opacity: 0.4;
  }
  :global(html.js:not(.reduce-motion)) .skill:global(.is-active) {
    opacity: 1;
    background: var(--glass-fill);
    box-shadow:
      inset 0 0 0 1px var(--glass-edge),
      inset 3px 0 0 var(--color-accent),
      0 18px 44px -26px rgb(22 24 29 / 0.28);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    backdrop-filter: blur(20px) saturate(160%);
  }
  @media (min-width: 1024px) {
    .skills-column {
      margin-left: auto;
      width: 48%;
    }
    .skills-list {
      margin-top: 4.5rem;
    }
    .skill {
      padding: 2.25rem 2rem;
      margin-inline: -2rem;
      margin-block: 0.75rem;
    }
  }
</style>
