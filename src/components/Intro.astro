---
// Pinned intro over the silk, 350vh tall, plum theme. Three panels are driven by scroll:
//   0 - 24%   name holds, then grows and lifts away (cloud: sphere beside the name)
//   24 - 58%  the statement is revealed word by word as you scroll (cloud: ring, still on the right)
//   58 - 94%  the four figures count up and stay (cloud: waving grid, centred)
//   94 - 100% everything is gone; the grid scatters into a star field before the page turns beige
// The cloud's own timing is on the section's data-shapes ("scene@position").
// Motion purpose: storytelling (who -> what -> proof) with the scroll as the timeline.
interface Props {
  name: string;
  tagline: string;
  statement: string;
  statementDetail: string;
  facts: { value: string; label: string }[];
}
const { name, tagline, statement, statementDetail, facts } = Astro.props;
---

<section id="intro" class="relative h-[350vh]" data-theme="plum" data-shapes="sphere@0>sphere@0.12>ring@0.3>ring@0.58>wave@0.72>wave@0.92>scatter@1" data-side="left" data-side-until="0.6">
  <div class="sticky top-0 h-dvh overflow-hidden">
    <!-- Panel 1: name, one line, two actions -->
    <div class="intro-panel absolute inset-0 flex items-center" data-panel="0">
      <div class="wrap pt-10" data-enter>
        <h1 class="text-[13vw] sm:text-[8.5vw] lg:text-[7.5rem] font-semibold leading-[0.95]" data-split>{name}</h1>
        <p class="mt-6 text-lg sm:text-xl text-muted max-w-[42ch] leading-snug">{tagline}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/work" class="btn btn-primary">See work <span class="arrow" aria-hidden="true">&rarr;</span></a>
          <a href="/contact" class="btn btn-secondary">Contact</a>
        </div>
      </div>
    </div>

    <!-- Panel 2: what I do; words light up with scroll -->
    <div class="intro-panel absolute inset-0 flex items-center" data-panel="1">
      <div class="wrap">
        <h2 class="text-3xl sm:text-5xl lg:text-[4.25rem] font-medium leading-[1.05] max-w-[20ch]" data-words>{statement}</h2>
        <p class="mt-8 text-lg text-muted max-w-[46ch] leading-relaxed">{statementDetail}</p>
      </div>
    </div>

    <!-- Panel 3: facts; numbers follow the scroll -->
    <div class="intro-panel absolute inset-0 flex items-center" data-panel="2">
      <dl class="wrap grid gap-10 grid-cols-2 lg:grid-cols-4">
        {
          facts.map((f) => (
            <div>
              <dd class="font-display text-5xl sm:text-7xl lg:text-8xl font-semibold" data-fact>{f.value}</dd>
              <dt class="mt-3 text-muted leading-snug max-w-[18ch]">{f.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Wraps each word of an element in its own span so it can be lit up one by one.
  function wrapWords(el: HTMLElement) {
    if (el.dataset.wordsDone) return;
    const words = (el.textContent ?? "").trim().split(/\s+/);
    el.textContent = "";
    for (const word of words) {
      const span = document.createElement("span");
      span.className = "word";
      span.textContent = word;
      el.appendChild(span);
      el.appendChild(document.createTextNode(" "));
    }
    el.dataset.wordsDone = "1";
  }

  // A tween that writes a counting number into an element ("10k+" keeps its suffix).
  function counter(el: HTMLElement) {
    const text = el.textContent ?? "";
    const match = text.match(/[\d.]+/);
    if (!match) return gsap.to({}, { duration: 1 });
    const target = Number(match[0]);
    const suffix = text.slice(match.index! + match[0].length);
    const state = { n: 0 };
    el.textContent = "0" + suffix;
    return gsap.to(state, { n: target, duration: 1, ease: "none", onUpdate: () => (el.textContent = Math.round(state.n) + suffix) });
  }

  function startIntro() {
    const intro = document.getElementById("intro");
    if (!intro) return;

    const panels = gsap.utils.toArray<HTMLElement>(".intro-panel");
    const statement = document.querySelector<HTMLElement>("[data-words]");
    const facts = gsap.utils.toArray<HTMLElement>("[data-fact]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    gsap.set(panels[0], { opacity: 1 });
    if (reducedMotion) return;

    if (statement) wrapWords(statement);
    const words = statement ? gsap.utils.toArray<HTMLElement>(".word", statement) : [];

    // The scroll timeline: 1 unit = the pinned distance. Positions below are fractions of it.
    const tl = gsap.timeline({
      defaults: { ease: "none" },
      scrollTrigger: { trigger: intro, start: "top top", end: "bottom bottom", scrub: 0.4 },
    });

    // Panel 1 grows slightly and lifts away.
    tl.to(panels[0], { opacity: 0, y: -90, scale: 1.06, duration: 0.14 }, 0.1);

    // Panel 2: enters, words light up one after another with the scroll, leaves.
    tl.fromTo(panels[1], { opacity: 0, y: 70 }, { opacity: 1, y: 0, duration: 0.08 }, 0.25)
      .fromTo(words, { opacity: 0.16 }, { opacity: 1, duration: 0.04, stagger: 0.2 / Math.max(words.length, 1) }, 0.3)
      .to(panels[1], { opacity: 0, y: -70, duration: 0.08 }, 0.55);

    // Panel 3: enters, figures count with the scroll, stays, then leaves just before the end.
    tl.fromTo(panels[2], { opacity: 0, y: 70 }, { opacity: 1, y: 0, duration: 0.08 }, 0.62);
    facts.forEach((el, i) => tl.add(counter(el).duration(0.16), 0.64 + i * 0.03));
    tl.to(panels[2], { opacity: 0, y: -70, duration: 0.05 }, 0.94);
    tl.set({}, {}, 1);
  }

  document.addEventListener("astro:page-load", startIntro);
</script>
