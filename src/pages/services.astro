---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
const services = (await getCollection("services")).sort((a, b) => a.data.id.localeCompare(b.data.id));
---

<Base title="Services">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 pt-36">
    <h1 class="text-4xl sm:text-6xl font-bold tracking-tight">Services</h1>
    <p class="mt-6 text-xl text-muted max-w-2xl leading-relaxed">
      Open to any kind of freelance engagement, from a focused integration to a full system. Scope, availability and rates are agreed per project.
    </p>
    <div class="rule mt-16"></div>
    <dl class="mt-12 grid gap-x-12 gap-y-12 sm:grid-cols-2">
      {
        services.map((s) => (
          <div class="reveal">
            <dt class="text-xl font-semibold">{s.data.title}</dt>
            <dd class="mt-3 text-muted leading-relaxed">{s.data.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Base>
