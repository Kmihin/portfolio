---
// Contact and the footer line, the last screen, with the model beside it (above it on phones).
// The email address is the main action, set as large as it fits; beside it a button copies it
// and confirms with a short pulse while "Copy email" crossfades to "Copied".
import { getCollection } from "astro:content";
const [profile] = await getCollection("profile");
const p = profile.data;
const year = new Date().getFullYear();
---

<section id="contact" class="contact" data-stop="contact">
  <div class="wrap contact-main">
    <div class="stage" data-stage="contact" aria-hidden="true"></div>
    <h2 class="heading" data-split>Tell me what you are <em>building.</em></h2>
    <p class="lead mt-8">I reply within a day or two, in English or Slovenian. Scope and terms are agreed per project.</p>
    <div class="contact-actions">
      <a href={`mailto:${p.email}`} class="contact-email" data-magnetic>
        {p.email}
        <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
      <button type="button" class="btn btn-secondary copy" data-copy={p.email}>
        <span class="copy-label">Copy email</span>
        <span class="copy-done" aria-hidden="true">Copied</span>
      </button>
      <span class="sr-only" aria-live="polite" data-copy-status></span>
    </div>
  </div>

  <footer class="wrap contact-foot">
    <p class="font-semibold">{p.name}</p>
    <ul class="flex flex-wrap gap-x-8 gap-y-2">
      <li><a href={p.linkedin} class="link hit" rel="noopener">LinkedIn</a></li>
      <li><a href={p.github} class="link hit" rel="noopener">GitHub</a></li>
    </ul>
    <p class="text-muted">{p.location}, {year}</p>
  </footer>
</section>

<script>
  // Copy the email address and confirm it: the button's label crossfades to "Copied" for two
  // seconds and a screen reader hears it.
  document.addEventListener("astro:page-load", () => {
    const button = document.querySelector<HTMLButtonElement>("[data-copy]");
    const status = document.querySelector<HTMLElement>("[data-copy-status]");
    if (!button) return;
    let timer = 0;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
      } catch {
        return; // no clipboard (e.g. not https): the mailto link still works
      }
      button.classList.remove("is-done");
      void button.offsetWidth; // restart the pulse when clicked again
      button.classList.add("is-done");
      if (status) status.textContent = "Email address copied";
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.classList.remove("is-done");
        if (status) status.textContent = "";
      }, 2000);
    });
  });
</script>

<style>
  .contact {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 5rem;
  }
  @media (min-width: 1024px) {
    .contact {
      padding-top: 9rem;
    }
  }
  .contact-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    margin-top: 3rem;
  }
  .contact-email {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    font-weight: 650;
    font-stretch: 106%;
    font-size: clamp(1.5rem, 4.2vw, 4rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
    padding-bottom: 0.08em;
    background: linear-gradient(var(--color-accent), var(--color-accent)) no-repeat left 100% / 100% 2px;
    transition: color 400ms ease, text-shadow 400ms ease;
  }
  .contact-email .arrow {
    display: inline-block;
    transition: translate 400ms var(--ease-out);
  }
  .contact-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 4rem;
    padding-block: 1.75rem;
    font-size: 0.875rem;
  }
  /* The two labels sit in the same place and crossfade (with a little blur). */
  .copy {
    display: inline-grid;
  }
  .copy > span {
    grid-area: 1 / 1;
    transition:
      opacity 200ms ease,
      filter 200ms ease;
  }
  .copy-done,
  .copy:global(.is-done) .copy-label {
    opacity: 0;
    filter: blur(4px);
  }
  .copy:global(.is-done) .copy-done {
    opacity: 1;
    filter: none;
  }
  .copy:global(.is-done) {
    animation: pulse 400ms var(--ease-out);
  }
  @keyframes pulse {
    40% {
      scale: 1.05;
    }
  }
  @media (min-width: 1024px) {
    /* The heading keeps to the left so the model has the right side. */
    .contact-main .heading {
      max-width: 11ch;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .contact-email:hover {
      color: var(--color-accent);
    }
    .contact-email:hover .arrow {
      translate: 0.2em 0;
    }
  }
</style>
