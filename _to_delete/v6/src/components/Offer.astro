---
// 03 What I offer: the services as a grid of quiet cells, an icon, a title and two lines each.
import { getCollection } from "astro:content";
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.id.localeCompare(b.data.id));
---

<section id="offer" class="border-t border-line">
  <div class="wrap py-24 sm:py-32 grid gap-14 lg:grid-cols-12">
    <div class="lg:col-span-3">
      <SectionHead number="03" first="What I" second="offer" />
      <p class="reveal mt-8 text-muted leading-relaxed max-w-[34ch]">
        From a focused integration to a complete system. Scope, availability and rates are agreed per project.
      </p>
    </div>

    <ul class="reveal grid sm:grid-cols-2 lg:col-span-9 border-t border-l border-line">
      {
        services.map((s) => (
          <li class="reveal-item cell border-b border-r border-line p-6 sm:p-8">
            <Icon name={s.data.icon} class="size-7 text-accent" />
            <h3 class="mt-5 text-2xl">{s.data.title}</h3>
            <p class="mt-3 text-sm text-muted leading-relaxed max-w-[44ch]">{s.data.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cell {
    transition: background-color var(--duration-base) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .cell:hover {
      background-color: rgba(201, 168, 106, 0.05);
    }
  }
</style>
