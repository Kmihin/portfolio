---
// Fixed header: a floating bar of frosted glass with the name, links to the chapters of the home
// page, and the contact button. Slides away on scroll down and returns on scroll up (motion.ts,
// hideHeaderOnScroll).
const links = [
  { href: "/#about", label: "About" },
  { href: "/#work", label: "Work" },
  { href: "/#skills", label: "Expertise" },
  { href: "/#offer", label: "Services" },
];
---

<header id="header" class="site-header">
  <div class="wrap">
    <nav class="bar glass" aria-label="Main">
      <a href="/#home" class="site-name">Kristjan Mihin</a>
      <ul class="hidden md:flex items-center gap-8">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="link text-sm text-muted hover:text-ink transition-colors">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/#contact" class="btn btn-primary bar-cta">Get in touch</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0.75rem;
    left: 0;
    right: 0;
    z-index: var(--z-header);
    transition: transform 500ms var(--ease-out);
  }
  .site-header:global(.is-hidden) {
    transform: translateY(-140%);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 3.5rem;
    padding: 0 0.4rem 0 1.4rem;
    border-radius: 999px;
  }
  .site-name {
    font-weight: 700;
    font-stretch: 115%;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .bar-cta {
    padding: 0.75rem 1.2rem;
    font-size: 0.875rem;
  }
</style>
