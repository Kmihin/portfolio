---
// The closing statement: a navy marble chess king on the left, one short heading and two plain
// paragraphs on the right.
import type { Copy } from "../lib/i18n";

interface Props {
  copy: Copy["closing"];
}
const { copy } = Astro.props;
---

<section id="closing" class="room section-bg bg-closing relative py-24 sm:py-32" data-theme="ivory">
  <div class="wrap room-grid closing-grid">
    <div class="closing-slot" data-sculpture="king" aria-hidden="true"></div>
    <div class="reveal">
      <h2 class="text-5xl sm:text-7xl leading-[1.0]" data-split>{copy.title}</h2>
      {copy.paragraphs.map((line, i) => <p class:list={["text-lg sm:text-xl text-muted leading-relaxed max-w-[48ch]", i === 0 ? "mt-8" : "mt-5"]}>{line}</p>)}
    </div>
  </div>
</section>

<style>
  .closing-slot {
    height: 46dvh;
  }
  @media (min-width: 1024px) {
    .closing-grid {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: center;
      gap: 4rem;
      min-height: 80dvh;
    }
    .closing-slot {
      height: min(70dvh, 40vw);
    }
  }
</style>
