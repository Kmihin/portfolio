---
// The features of a case study as a grid: each a screenshot with its one-line text as caption.
// One column on phones, two from md up. A feature without a screenshot is a plain text cell.
interface Feature {
  text: string;
  image?: { src: string; alt: string; width: number; height: number };
}
interface Props {
  features: Feature[];
  note?: string;
}
const { features, note } = Astro.props;
---

<section class="mt-20 lg:mt-28" aria-labelledby="features-title">
  <h2 id="features-title" class="heading-sm">Features</h2>
  <ul class="mt-8 grid gap-x-8 gap-y-12 md:grid-cols-2 reveal">
    {
      features.map((feature) => (
        <li>
          {feature.image ? (
            <figure>
              <img
                src={feature.image.src}
                alt={feature.image.alt}
                width={feature.image.width}
                height={feature.image.height}
                loading="lazy"
                decoding="async"
                class="shot"
              />
              <figcaption class="mt-4 text-muted leading-relaxed max-w-[52ch]">{feature.text}</figcaption>
            </figure>
          ) : (
            <p class="text-only leading-relaxed">{feature.text}</p>
          )}
        </li>
      ))
    }
  </ul>
  {note && <p class="mt-8 text-sm text-muted">{note}</p>}
</section>

<style>
  .shot {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-image);
  }
  /* A feature without a screenshot: the text on an accent line, so it still reads as a grid cell. */
  .text-only {
    border-top: 1px solid var(--color-accent);
    padding-top: 1.25rem;
    max-width: 52ch;
  }
</style>
