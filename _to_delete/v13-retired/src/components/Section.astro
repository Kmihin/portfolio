---
interface Props {
  title: string;
  id?: string;
}
const { title, id } = Astro.props;
---

<section id={id} class="max-w-6xl mx-auto px-5 sm:px-8 mt-32">
  <div class="reveal">
    <div class="rule"></div>
    <h2 class="mt-8 text-3xl sm:text-4xl">{title}</h2>
  </div>
  <div class="mt-10">
    <slot />
  </div>
</section>
