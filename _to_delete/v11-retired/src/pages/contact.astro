---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
const [profile] = await getCollection("profile");
const p = profile.data;
---

<Base title="Contact">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 pt-36">
    <h1 class="text-4xl sm:text-6xl font-bold tracking-tight">Contact</h1>
    <p class="mt-6 text-xl text-muted max-w-xl leading-relaxed">
      Tell me what you're building. I reply within a day or two, in English or Slovenian.
    </p>
    <a href={`mailto:${p.email}`} class="inline-block mt-12 text-2xl sm:text-4xl text-gold underline underline-offset-8 hover:text-ink transition-colors break-all">{p.email}</a>
    <div class="rule mt-16"></div>
    <dl class="mt-10 grid gap-8 sm:grid-cols-2 max-w-xl">
      <div>
        <dt class="text-sm text-muted">LinkedIn</dt>
        <dd class="mt-1"><a href={p.linkedin} class="hover:text-gold" rel="noopener">linkedin.com/in/kristjan-mihin</a></dd>
      </div>
      <div>
        <dt class="text-sm text-muted">GitHub</dt>
        <dd class="mt-1"><a href={p.github} class="hover:text-gold" rel="noopener">github.com/Kmihin</a></dd>
      </div>
    </dl>
  </div>
</Base>
