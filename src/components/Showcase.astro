---
// A room with a list (work, expertise, what I offer): the number, the two-line title and a lead on
// top; below it the index on the left, the room's sculpture in the middle and the picked item on
// the right. Picking an entry or an arrow shows that item, and the sculpture follows
// (src/scripts/showcase.ts, sculptures.ts): `sculpture` names the room's sculpture ("prism",
// "balance") or "work", where `objects` lists the case study objects in the order of the items.
// While the room is on screen it moves on to the next item every `interval` seconds; a brass line
// under the picked entry fills up until then.
import { words } from "../lib/words";

export interface Item {
  /** Short name shown in the index. */
  label: string;
  title: string;
  text: string;
  facts?: { label: string; value: string }[];
  link?: { href: string; label: string };
  /** A second link beside it (a live site, the source). */
  more?: { href: string; label: string };
}

interface Props {
  id: string;
  /** Room number shown above the title ("02"). */
  number: string;
  /** The title is set on two lines: `title`, then `titleEm` in brass italic. */
  title: string;
  titleEm: string;
  lead: string;
  items: Item[];
  /** Section background class from global.css, e.g. "bg-work". */
  background: string;
  sculpture: string;
  objects?: string[];
  /** Seconds each item stays before the next one. */
  interval?: number;
  /** The arrows' labels for screen readers, in the page's language. */
  arrows: { previous: string; next: string };
}
const { id, number, title, titleEm, lead, background, items, sculpture, objects, interval = 15, arrows } = Astro.props;
---

<section id={id} class:list={["room section-bg relative py-24 sm:py-32", background]} data-showcase={sculpture} data-interval={interval} data-theme="ivory">
  <div class="wrap">
    <div class="reveal">
      <p class="section-number">{number} <span class="section-line" aria-hidden="true"></span></p>
      <h2 class="room-title mt-5">
        <span class="block" data-split>{title}</span>
        <em class="block text-accent" data-split>{titleEm}</em>
      </h2>
      <p class="mt-6 text-lg text-muted leading-relaxed max-w-[48ch]">{lead}</p>
    </div>

    <div class="room-grid showcase-grid mt-12 lg:mt-14">
      <ol class="index flex flex-wrap gap-x-6 gap-y-1 lg:flex-col lg:gap-1 text-sm">
        {
          items.map((item, i) => (
            <li>
              <button type="button" class="index-item" data-go={i} aria-pressed={i === 0 ? "true" : "false"}>
                {item.label}
                <span class="index-bar" data-bar aria-hidden="true" />
              </button>
            </li>
          ))
        }
      </ol>

      <div class="showcase-slot" data-sculpture={sculpture} data-objects={objects?.join(",")} aria-hidden="true"></div>

      <div class="min-w-0">
        <div class="stage">
          {
            items.map((item) => (
              <article class="item" data-item>
                <h3 class="text-3xl sm:text-4xl leading-[1.08]">
                  {words(item.title).map((w) => (w.nowrap ? <><span class="sm:whitespace-nowrap">{w.text}</span> </> : <>{w.text} </>))}
                </h3>
                <p class="mt-4 text-base text-muted leading-relaxed max-w-[46ch]">{item.text}</p>
                {item.facts && (
                  <dl class="mt-6 grid gap-4 text-sm">
                    {item.facts.map((f) => (
                      <div class="border-t border-line pt-3">
                        <dt class="text-muted">{f.label}</dt>
                        <dd class="mt-1 leading-snug">{f.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
                {item.link && (
                  <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
                    <a href={item.link.href} class="link inline-block">
                      {item.link.label} <span class="arrow" aria-hidden="true">&rarr;</span>
                    </a>
                    {item.more && (
                      <a href={item.more.href} class="link inline-block" rel="noopener">
                        {item.more.label} <span class="arrow" aria-hidden="true">&rarr;</span>
                      </a>
                    )}
                  </div>
                )}
              </article>
            ))
          }
        </div>
        <div class="mt-8 flex gap-3">
          <button type="button" class="step-btn" data-prev aria-label={arrows.previous}>&larr;</button>
          <button type="button" class="step-btn" data-next aria-label={arrows.next}>&rarr;</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* All items share one cell, so the stage is as tall as the tallest item and nothing jumps. */
  .stage {
    display: grid;
  }
  .item {
    grid-area: 1 / 1;
  }
  .showcase-slot {
    height: 44dvh;
  }
  @media (min-width: 1024px) {
    .showcase-grid {
      grid-template-columns: 0.55fr 1.3fr 1fr;
      align-items: center;
      gap: 3rem;
    }
    .showcase-slot {
      height: min(62dvh, 38vw);
    }
  }
  /* Index entries: quiet until picked; under the picked one a brass line fills up until the next
     item (showcase.ts), under the others a faint hairline. */
  .index-item {
    position: relative;
    display: block;
    padding: 0.4rem 0;
    text-align: left;
    opacity: 0.5;
    transition: opacity var(--duration-base) ease;
  }
  .index-item[aria-pressed="true"] {
    opacity: 1;
  }
  .index-bar {
    position: absolute;
    left: 0;
    bottom: 0.2rem;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }
  @media (hover: hover) and (pointer: fine) {
    .index-item:hover {
      opacity: 1;
    }
  }

  /* Arrows: square, hairline, press feedback. */
  .step-btn {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 1.125rem;
    transition:
      transform var(--duration-fast) var(--ease-out),
      border-color var(--duration-base) ease;
  }
  .step-btn:active {
    transform: scale(0.95);
  }
  @media (hover: hover) and (pointer: fine) {
    .step-btn:hover {
      border-color: var(--accent);
    }
  }
</style>
