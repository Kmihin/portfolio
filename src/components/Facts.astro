---
// Four figures in a row under the about text, each under a hairline; each number counts
// up when it enters (data-count).
interface Props {
  facts: { value: string; label: string }[];
}
const { facts } = Astro.props;
---

<section class="wrap pb-24 lg:pb-36" aria-label="In numbers">
  <dl class="facts reveal">
    {
      facts.map((fact) => (
        <div class="fact">
          <dd class="fact-value tabular" data-count>{fact.value}</dd>
          <dt class="fact-label">{fact.label}</dt>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 1.5rem;
  }
  .fact {
    border-top: 1px solid var(--color-line);
    padding-top: 1rem;
  }
  .fact-value {
    font-weight: 700;
    font-stretch: 112%;
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    line-height: 0.9;
  }
  .fact-label {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-muted);
    max-width: 20ch;
  }
  @media (min-width: 1024px) {
    .facts {
      grid-template-columns: repeat(4, 1fr);
      max-width: 62%;
    }
  }
</style>
