---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import CaseFeatures from "../../components/CaseFeatures.astro";

export async function getStaticPaths() {
  const byYear = (a: any, b: any) => b.data.year.localeCompare(a.data.year);
  const all = [...(await getCollection("professional")).sort(byYear), ...(await getCollection("projects")).sort(byYear)];
  return all.map((entry, i) => ({
    params: { slug: entry.data.slug },
    props: { entry, next: all[(i + 1) % all.length] },
  }));
}

const { entry, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const kind = d.type === "project" ? "Own product" : "Professional work";
---

<Base title={d.title} description={d.summary}>
  <article data-stop="detail">
    <header class="wrap pt-32 lg:pt-44 pb-14 lg:pb-20">
      <a href="/#work" class="link text-sm text-muted" data-enter>&larr; All work</a>
      <h1 class="heading case-title mt-8" data-split>{d.title}</h1>
      <div class="mt-8 max-w-3xl" data-enter>
        {d.tagline && <p class="text-2xl font-semibold tracking-tight text-accent-ink">{d.tagline}</p>}
        <p class="lead mt-4">{d.summary}</p>
        <p class="label mt-8">{kind}, {d.year}</p>
      </div>
    </header>

    <div class="wrap">
      {
        d.cover && (
          <div class="cover glass" data-unveil>
            <img src={d.cover.src} alt={d.cover.alt} width={d.cover.width} height={d.cover.height} fetchpriority="high" />
          </div>
        )
      }

      {d.features.length > 0 && <CaseFeatures features={d.features} note={d.featuresNote} />}

      <div class="mt-20 lg:mt-28 grid gap-12 lg:grid-cols-12">
        <!-- Sticky facts column -->
        <aside class="lg:col-span-4 lg:sticky lg:top-28 lg:self-start">
          <dl class="facts-panel glass reveal">
            <div>
              <dt class="label">Role</dt>
              <dd class="mt-2 leading-relaxed">{d.role}</dd>
            </div>
            <div>
              <dt class="label">Stack</dt>
              <dd class="mt-3 flex flex-wrap gap-2">
                {d.stack.map((s) => <span class="tag">{s}</span>)}
              </dd>
            </div>
            {
              (d.links.repo || d.links.live) && (
                <div>
                  <dt class="label">Links</dt>
                  <dd class="mt-2 flex flex-col items-start gap-2">
                    {d.links.live && (
                      <span>
                        <a href={d.links.live} class="link text-accent-ink font-semibold" rel="noopener">
                          {d.links.liveLabel ?? "Live site"} &nearr;
                        </a>
                        {d.links.liveNote && <span class="block mt-1 text-xs text-muted">{d.links.liveNote}</span>}
                      </span>
                    )}
                    {d.links.repo && (
                      <a href={d.links.repo} class="link text-accent-ink font-semibold" rel="noopener">
                        Source on GitHub &nearr;
                      </a>
                    )}
                  </dd>
                </div>
              )
            }
          </dl>
        </aside>

        <div class="prose lg:col-span-7 lg:col-start-6 max-w-[64ch]">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <!-- Next case study -->
  <a href={`/work/${next.data.slug}`} class="next-link">
    <div class="wrap py-16 lg:py-24">
      <p class="label">Next</p>
      <p class="heading next-title mt-4">
        {next.data.label ?? next.data.title}
        <span class="arrow" aria-hidden="true">&rarr;</span>
      </p>
    </div>
  </a>
</Base>

<style>
  .case-title {
    max-width: 18ch;
  }
  .cover {
    overflow: hidden;
    padding: 0.6rem;
    border-radius: var(--radius-panel);
  }
  .cover img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-image);
  }
  .facts-panel {
    display: grid;
    gap: 1.75rem;
    padding: 1.75rem;
    border-radius: var(--radius-panel);
  }
  .next-link {
    position: relative;
    z-index: var(--z-page);
    display: block;
    margin-top: 7rem;
    border-top: 1px solid var(--glass-edge);
    background: var(--glass-fill);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
    backdrop-filter: blur(22px) saturate(180%);
  }
  .next-title {
    transition: color 300ms ease;
  }
  .next-title .arrow {
    display: inline-block;
    transition: translate 500ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .next-link:hover .next-title {
      color: var(--color-accent-ink);
    }
    .next-link:hover .arrow {
      translate: 0.2em 0;
    }
  }
</style>
