---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const all = [...(await getCollection("professional")), ...(await getCollection("projects"))];
  return all.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<Base title={d.title} description={d.summary}>
  <div class="max-w-6xl mx-auto px-5 sm:px-8 pt-36">
    <a href="/work" class="text-sm text-muted hover:text-gold">Back to all work</a>

    <p class="mt-10 text-sm text-muted">{d.type === "project" ? "Side project" : "Professional"}, {d.year}</p>
    <h1 class="mt-3 text-3xl sm:text-5xl font-bold tracking-tight leading-tight max-w-4xl">{d.title}</h1>
    <p class="mt-6 text-xl text-muted leading-relaxed max-w-2xl">{d.summary}</p>

    <div class="rule mt-12"></div>
    <div class="mt-8 grid gap-8 sm:grid-cols-[1fr_2fr] text-sm">
      <div>
        <p class="text-muted">Role</p>
        <p class="mt-1">{d.role}</p>
        {
          (d.links.repo || d.links.live) && (
            <div class="mt-5 flex flex-col gap-1">
              {d.links.live && <a href={d.links.live} class="text-gold underline underline-offset-4" rel="noopener">Live site</a>}
              {d.links.repo && <a href={d.links.repo} class="text-gold underline underline-offset-4" rel="noopener">Source on GitHub</a>}
            </div>
          )
        }
      </div>
      <div>
        <p class="text-muted">Stack</p>
        <p class="mt-1 leading-relaxed">{d.stack.join(" / ")}</p>
      </div>
    </div>

    <article class="prose-basic mt-4 max-w-2xl">
      <Content />
    </article>
  </div>
</Base>
