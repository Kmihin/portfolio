---
// About: the portrait, the first sentence large and read word by word by the scroll (data-scrub),
// then the rest. On wide screens the text keeps to the left; the chrome drifts on the right.
interface Props {
  statement: string;
  paragraphs: string[];
}
const { statement, paragraphs } = Astro.props;
---

<section id="about" class="section about" data-stop="about">
  <div class="wrap">
    <div class="about-text">
      <img src="/portrait.jpg" alt="Kristjan Mihin" width="640" height="800" loading="lazy" class="about-photo" />
      <p class="about-statement" data-scrub>{statement}</p>
      <div class="mt-10 grid gap-5 reveal">
        {paragraphs.map((paragraph) => <p class="lead">{paragraph}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: flex;
    align-items: center;
  }
  .about-statement {
    font-weight: 650;
    font-stretch: 108%;
    font-size: clamp(1.75rem, 3.5vw, 3.25rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }
  .about-photo {
    width: 7rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-panel);
    margin-bottom: 2.5rem;
  }
  @media (min-width: 1024px) {
    .about {
      min-height: 100dvh;
    }
    .about-text {
      max-width: 52%;
    }
  }
</style>
