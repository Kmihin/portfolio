---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  /** Long article pages show a thin reading-progress bar under the header. */
  progress?: boolean;
}

const {
  title,
  description = "Kristjan Mihin, full-stack developer. Web applications, integrations and cloud infrastructure on .NET, Azure and React.",
  progress = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Kristjan Mihin</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} | Kristjan Mihin`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#e9dfcf" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
    <script is:inline>
      // Mark the document before first paint so motion start states apply only when JS runs.
      document.documentElement.classList.add("js");
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("reduce-motion");
    </script>
  </head>
  <body class="min-h-dvh flex flex-col">
    <canvas id="silk" aria-hidden="true"></canvas>
    <canvas id="particles" aria-hidden="true"></canvas>
    <Header />
    {progress && <div id="progress" class="fixed top-0 inset-x-0 z-30 h-0.5 bg-ink origin-left" aria-hidden="true"></div>}
    <main class="flex-1 w-full" transition:animate="fade">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // Start the motion layer on first load and after every client-side navigation;
  // tear it down before the DOM is swapped so nothing animates a dead page.
  import { startMotion, stopMotion } from "../scripts/motion";

  document.addEventListener("astro:page-load", startMotion);
  document.addEventListener("astro:before-swap", (event) => {
    stopMotion();
    // Carry the pre-paint flags over to the incoming document so start states apply there too.
    const next = (event as any).newDocument.documentElement as HTMLElement;
    next.classList.add("js");
    if (document.documentElement.classList.contains("reduce-motion")) next.classList.add("reduce-motion");
  });
</script>
