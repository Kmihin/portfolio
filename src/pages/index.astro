---
// The whole site is this one page. Behind it a body of liquid chrome (src/scripts/scene.ts) flows
// down the page and takes a new form for every chapter: each section names its stop with data-stop.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Facts from "../components/Facts.astro";
import Featured from "../components/Featured.astro";
import WorkList from "../components/WorkList.astro";
import type { WorkGroup, WorkRow } from "../components/WorkList.astro";
import Expertise from "../components/Expertise.astro";
import Offer from "../components/Offer.astro";
import Closing from "../components/Closing.astro";
import Contact from "../components/Contact.astro";

const byId = (a: any, b: any) => a.data.id.localeCompare(b.data.id);
// Featured studies first, then the most recently active ("2022-2026" counts as 2026).
const lastYear = (w: any) => String(w.data.year).split("-").pop() ?? "";
const byFeaturedThenYear = (a: any, b: any) => Number(b.data.featured) - Number(a.data.featured) || lastYear(b).localeCompare(lastYear(a));

const skills = (await getCollection("skills")).sort(byId);
const services = (await getCollection("services")).sort(byId);
const professional = (await getCollection("professional")).sort(byFeaturedThenYear);
const projects = (await getCollection("projects")).sort(byFeaturedThenYear);

// The study shown large with its screenshot: the first own product that has a cover image.
const featured = projects.find((p) => p.data.cover);

const toRow = (w: (typeof projects)[number]): WorkRow => ({
  slug: w.data.slug,
  name: w.data.label ?? w.data.title,
  summary: w.data.summary,
  year: w.data.year,
  stack: w.data.stack.slice(0, 4),
});
const groups: WorkGroup[] = [
  { title: "Professional work", rows: professional.map(toRow) },
  { title: "Own products", rows: projects.filter((p) => p !== featured).map(toRow) },
];

const about = {
  statement: "I'm a full-stack developer with 5+ years of experience in modern web applications, cloud infrastructure and system integrations.",
  paragraphs: [
    "I care about security as much as features: who can see and change what, roles and rights between companies, and data that moves safely between systems.",
    "I enjoy solving complex problems, working with new technologies and building solutions that make a real difference.",
  ],
};

const facts = [
  { value: "5+", label: "years of professional experience" },
  { value: "10k+", label: "documents a year through a platform I designed" },
  { value: "10+", label: "servers migrated to Azure" },
  { value: "3", label: "own products live" },
];

---

<Base title="Full-stack developer" footer={false}>
  <Hero first="Kristjan" last="Mihin" tagline="Full-stack developer. I build business web applications, integrations and cloud infrastructure on .NET and Azure." />
  <About statement={about.statement} paragraphs={about.paragraphs} />
  <Facts facts={facts} />

  <section id="work" class="section" data-stop="work">
    <div class="wrap">
      <h2 class="heading" data-split>Selected work</h2>
      <p class="lead mt-6">Systems built in employment, described without client names, and products of my own.</p>
      {
        featured && featured.data.cover && (
          <div class="mt-14 lg:mt-20">
            <Featured slug={featured.data.slug} title={featured.data.title} tagline={featured.data.tagline} summary={featured.data.summary} cover={featured.data.cover} />
          </div>
        )
      }
      <div class="mt-24 lg:mt-32">
        <WorkList groups={groups} />
      </div>
    </div>
  </section>

  <Expertise items={skills.map((s) => s.data)} />
  <Offer lead="From a focused integration to a complete system. Scope, availability and rates are agreed per project." items={services.map((s) => s.data)} />
  <Closing />
  <Contact />
</Base>
