---
// Footer on the ivory paper. The contact marble with its navy mountain range rising on the left
// (.footer-bg in global.css) runs behind it and up into the end of the contact section, so the
// footer text sits on the right (on phones above the mountains).
import { getCollection } from "astro:content";
const [profile] = await getCollection("profile");
const p = profile.data;
const year = new Date().getFullYear();
---

<footer class="footer-bg relative mt-24 sm:mt-32">
  <div class="wrap pb-[68vw] lg:pb-0">
    <div class="lg:ml-auto lg:w-[46%]">
      <span class="rule" aria-hidden="true"></span>
      <div class="py-12">
      <p class="font-display text-xl tracking-[0.02em]">{p.name}</p>
      <p class="mt-1 text-sm text-muted">{p.location}</p>
      <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm">
        <li><a href={`mailto:${p.email}`} class="link">{p.email}</a></li>
        <li><a href={p.github} class="link" rel="noopener">GitHub</a></li>
        <li><a href={p.linkedin} class="link" rel="noopener">LinkedIn</a></li>
      </ul>
        <p class="mt-6 text-xs text-muted">{year}</p>
      </div>
    </div>
  </div>
</footer>
