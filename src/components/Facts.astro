---
// Four figures in a row under the about text; each number counts up when it enters (data-count).
interface Props {
  facts: { value: string; label: string }[];
}
const { facts } = Astro.props;
---

<section class="wrap pb-28 lg:pb-40" aria-label="In numbers">
  <dl class="facts reveal">
    {
      facts.map((fact) => (
        <div class="fact">
          <dd class="fact-value" data-count>{fact.value}</dd>
          <dt class="mt-3 text-sm text-muted leading-snug max-w-[20ch]">{fact.label}</dt>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 1.5rem;
    border-top: 1px solid var(--color-line);
    padding-top: 2.5rem;
  }
  .fact-value {
    font-weight: 800;
    font-stretch: 120%;
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  @media (min-width: 1024px) {
    .facts {
      grid-template-columns: repeat(4, 1fr);
      max-width: 62%;
    }
    .fact-value {
      font-size: clamp(2.5rem, 4.2vw, 4.5rem);
    }
  }
</style>
