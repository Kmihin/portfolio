---
// The opening screen: the name in the widest, heaviest cut of the typeface across the top, the
// liquid chrome and its glass ring in front of it, one line of what I do and the two buttons
// along the bottom. While the 3D scene runs it draws the name itself, in the same place, so the
// glass can bend the letters; the h1 here is then only kept transparent (html.scene-on).
// Without the scene the h1 is shown and rises letter by letter (motion.ts, openPage).
interface Props {
  first: string;
  last: string;
  tagline: string;
}
const { first, last, tagline } = Astro.props;
---

<section id="home" class="hero" data-stop="hero">
  <div class="wrap hero-inner">
    <h1 id="hero-name" class="hero-name">
      <span class="block">{first}</span>
      <span class="block">{last}</span>
    </h1>
    <div class="hero-foot">
      <p class="hero-tagline" data-enter>{tagline}</p>
      <div class="flex flex-wrap items-center gap-3" data-enter>
        <a href="/#work" class="btn btn-primary" data-magnetic>View work <span class="arrow" aria-hidden="true">&rarr;</span></a>
        <a href="/#contact" class="btn btn-secondary" data-magnetic>Get in touch</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100dvh;
    display: flex;
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 5.5rem;
    padding-bottom: 2.5rem;
  }
  .hero-name {
    font-weight: 850;
    font-stretch: 125%;
    font-size: clamp(3.25rem, 13.2vw, 15rem);
    line-height: 0.84;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    margin-left: -0.04em;
  }
  :global(html.scene-on) .hero-name {
    color: transparent;
    opacity: 1;
  }
  .hero-foot {
    margin-top: 2.5rem;
    display: grid;
    gap: 1.75rem;
  }
  .hero-tagline {
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    font-weight: 500;
    line-height: 1.4;
    max-width: 34ch;
    text-wrap: balance;
  }
  @media (min-width: 1024px) {
    /* Wide screens: the name at the top, the tagline and buttons at the bottom, the chrome between. */
    .hero-inner {
      justify-content: space-between;
      padding-bottom: 3.5rem;
    }
  }
</style>
