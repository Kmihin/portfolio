---
// Pinned intro over the velvet, 320vh tall, midnight theme. Three panels are driven by scroll:
//   0 - 24%   editorial opening: one line on what I do with the two calls to action, and the name
//             as a full-width masthead at the bottom under a brass hairline; my photo stands on the
//             right behind the name, and behind everything the particles form a spiral galaxy, quiet
//   24 - 58%  a short statement and three pillars of the work (cloud: ring, on the right)
//   58 - 100% the four figures count up in brass over a turning globe and stay; when the pin ends
//             the figures and the globe scroll away together (the cloud is anchored to the stage)
// The cloud's own timing is on the section's data-shapes ("scene@position").
// Motion purpose: storytelling (who -> what -> proof) with the scroll as the timeline.
interface Props {
  name: string;
  tagline: string;
  primary: { href: string; label: string };
  secondary: { href: string; label: string };
  /** The statement is set as `statement` followed by `statementEm` in brass italic. */
  statement: string;
  statementEm: string;
  statementDetail: string;
  pillars: { title: string; text: string }[];
  facts: { value: string; label: string }[];
}
const { name, tagline, primary, secondary, statement, statementEm, statementDetail, pillars, facts } = Astro.props;
const [first, last] = name.split(" ");
---

<section id="intro" class="relative h-[320vh]" data-theme="midnight" data-shapes="galaxy@0>galaxy@0.12>ring@0.3>ring@0.58>globe@0.7>globe@1" data-faint-until="0.1" data-side="left" data-center-until="0.12" data-side-until="0.6">
  <div class="sticky top-0 h-dvh overflow-hidden" data-cloud data-cloud-fit="none">
    <!-- Panel 1: the opening line in the upper half, the name as a full-width masthead at the bottom -->
    <div class="intro-panel isolate absolute inset-0 flex flex-col justify-between pt-28 sm:pt-32 pb-8 sm:pb-10" data-panel="0">
      <img src="/portrait-cutout.webp" alt="" class="hero-photo" width="880" height="880" fetchpriority="high" />
      <div class="wrap relative" data-enter>
        <p class="text-lg sm:text-2xl leading-snug max-w-[40ch]" data-tagline>{tagline}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={primary.href} class="btn btn-primary">{primary.label}</a>
          <a href={secondary.href} class="btn btn-secondary">{secondary.label} <span class="arrow" aria-hidden="true">&rarr;</span></a>
        </div>
      </div>

      <div class="wrap relative">
        <span class="rule" data-rule aria-hidden="true"></span>
        <h1 class="masthead mt-5 sm:mt-7 w-max" data-masthead aria-label={name}>
          <span class="masthead-word">{first}</span><br class="sm:hidden" /> <em class="masthead-word">{last}</em>
        </h1>
      </div>
    </div>

    <!-- Panel 2: what I do, in one line, and the three parts of it -->
    <div class="intro-panel absolute inset-0 flex items-center" data-panel="1">
      <div class="wrap">
        <div class="shield w-fit">
          <h2 class="text-5xl sm:text-6xl lg:text-7xl leading-[1.08] max-w-[16ch]">{statement} <em class="text-accent">{statementEm}</em></h2>
          <p class="mt-6 text-lg text-muted max-w-[46ch] leading-relaxed">{statementDetail}</p>
        </div>
        <dl class="mt-12 grid gap-8 sm:grid-cols-3 max-w-4xl">
          {
            pillars.map((pillar) => (
              <div class="pillar pt-5">
                <dt class="font-display text-2xl">{pillar.title}</dt>
                <dd class="mt-2 text-sm text-muted leading-relaxed max-w-[30ch]">{pillar.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <!-- Panel 3: facts; numbers follow the scroll -->
    <div class="intro-panel absolute inset-0 flex items-center" data-panel="2">
      <dl class="wrap grid gap-10 grid-cols-2 lg:grid-cols-4">
        {
          facts.map((f) => (
            <div class="shield">
              <dd class="font-display text-6xl sm:text-7xl lg:text-8xl text-accent leading-none" data-fact>{f.value}</dd>
              <dt class="mt-4 text-muted leading-snug max-w-[18ch]">{f.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // A tween that writes a counting number into an element ("10k+" keeps its suffix).
  function counter(el: HTMLElement) {
    const text = el.textContent ?? "";
    const match = text.match(/[\d.]+/);
    if (!match) return gsap.to({}, { duration: 1 });
    const target = Number(match[0]);
    const suffix = text.slice(match.index! + match[0].length);
    const state = { n: 0 };
    el.textContent = "0" + suffix;
    return gsap.to(state, { n: target, duration: 1, ease: "none", onUpdate: () => (el.textContent = Math.round(state.n) + suffix) });
  }

  // Sizes the masthead so its widest line fills the content width exactly.
  function fitMasthead(el: HTMLElement) {
    const container = el.parentElement!;
    const style = getComputedStyle(container);
    const available = container.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
    el.style.fontSize = "100px";
    el.style.fontSize = `${(100 * available) / el.getBoundingClientRect().width}px`;
  }

  // Splits each word into letters inside a clipped box, so the letters can rise into view.
  function splitLetters(el: HTMLElement) {
    if (el.dataset.lettersDone) return;
    el.querySelectorAll<HTMLElement>(".masthead-word").forEach((word) => {
      const letters = (word.textContent ?? "").split("");
      word.textContent = "";
      for (const letter of letters) {
        const span = document.createElement("span");
        span.className = "masthead-letter";
        span.textContent = letter;
        word.appendChild(span);
      }
    });
    el.dataset.lettersDone = "1";
  }

  function startIntro() {
    const intro = document.getElementById("intro");
    if (!intro) return;

    const masthead = document.querySelector<HTMLElement>("[data-masthead]");
    if (masthead) {
      fitMasthead(masthead);
      const refit = () => fitMasthead(masthead);
      window.addEventListener("resize", refit);
      document.fonts.ready.then(refit);
      document.addEventListener("astro:before-swap", () => window.removeEventListener("resize", refit), { once: true });
    }

    const panels = gsap.utils.toArray<HTMLElement>(".intro-panel");
    const facts = gsap.utils.toArray<HTMLElement>("[data-fact]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    gsap.set(panels[0], { opacity: 1 });
    if (reducedMotion) return;

    // Load: the masthead letters rise one after another; the rule above them is drawn by motion.ts.
    if (masthead) {
      splitLetters(masthead);
      gsap.fromTo(".masthead-letter", { yPercent: 105 }, { yPercent: 0, duration: 1.2, ease: "expo.out", stagger: 0.04, delay: 0.2 });
    }

    // The scroll timeline: 1 unit = the pinned distance. Positions below are fractions of it.
    const tl = gsap.timeline({
      defaults: { ease: "none" },
      scrollTrigger: { trigger: intro, start: "top top", end: "bottom bottom", scrub: 0.4 },
    });

    // Panel 1 lifts away; the masthead drifts up a little faster than the rest.
    tl.to(panels[0], { opacity: 0, y: -90, duration: 0.14 }, 0.1);
    if (masthead) tl.to(masthead, { y: -60, duration: 0.14 }, 0.1);

    // Panel 2: enters, holds, leaves.
    tl.fromTo(panels[1], { opacity: 0, y: 70 }, { opacity: 1, y: 0, duration: 0.08 }, 0.25).to(panels[1], { opacity: 0, y: -70, duration: 0.08 }, 0.55);

    // Panel 3: enters, figures count with the scroll, stays, then leaves just before the end.
    tl.fromTo(panels[2], { opacity: 0, y: 70 }, { opacity: 1, y: 0, duration: 0.08 }, 0.62);
    facts.forEach((el, i) => tl.add(counter(el).duration(0.16), 0.64 + i * 0.03));
    tl.set({}, {}, 1);
  }

  document.addEventListener("astro:page-load", startIntro);
</script>

<style>
  /* My photo on the opening screen: cut out, standing on the right behind the name, toned toward
     the palette and fading into the velvet at the bottom. It rises in once on load. */
  .hero-photo {
    position: absolute;
    right: 2%;
    bottom: 0;
    height: 94%;
    width: auto;
    max-width: none;
    z-index: 0;
    pointer-events: none;
    /* Toned down so the ivory name stays the brightest thing on the screen. */
    filter: saturate(0.5) sepia(0.15) contrast(1.05) brightness(0.78);
    -webkit-mask-image: linear-gradient(to bottom, #000 42%, rgba(0, 0, 0, 0.55) 62%, transparent 86%);
    mask-image: linear-gradient(to bottom, #000 42%, rgba(0, 0, 0, 0.55) 62%, transparent 86%);
    animation: photo-in 1.4s var(--ease-out) 0.3s both;
  }
  @keyframes photo-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  /* Phones: smaller, centred between the opening line and the name, quieter behind the text. */
  @media (max-width: 767px) {
    .hero-photo {
      right: 50%;
      transform: translateX(50%);
      height: 52%;
      bottom: 16%;
      opacity: 0.45;
      animation: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-photo {
      animation: none;
    }
  }
  /* The panels lie on top of each other; only the one on show takes clicks (its buttons and links). */
  .intro-panel {
    pointer-events: none;
  }
  .intro-panel :global(a),
  .intro-panel :global(button) {
    pointer-events: auto;
  }
  /* Each pillar opens with a short brass rule over a full ivory hairline: two colours, one line. */
  .pillar {
    background:
      linear-gradient(var(--accent), var(--accent)) top left / 2.5rem 1px no-repeat,
      linear-gradient(var(--line), var(--line)) top left / 100% 1px no-repeat;
  }

  .masthead {
    font-size: 12vw; /* replaced by fitMasthead() once the page runs */
    line-height: 0.86;
    letter-spacing: -0.02em;
    font-variation-settings: "opsz" 40;
  }
  /* Each word clips its letters so they can rise out of the baseline. */
  .masthead :global(.masthead-word) {
    display: inline-block;
    overflow: hidden;
    /* room for descenders (the j) inside the clip, taken back so the lines stay tight */
    padding-bottom: 0.2em;
    margin-bottom: -0.2em;
    vertical-align: top;
  }
  .masthead :global(.masthead-letter) {
    display: inline-block;
  }
  /* The italic surname leans past its box; a little air on the right keeps the last letter whole. */
  .masthead em {
    padding-right: 0.06em;
  }
  /* Reduced motion: no pin, the three panels simply follow each other. */
  :global(.reduce-motion) #intro {
    height: auto;
  }
  :global(.reduce-motion) #intro .sticky {
    position: static;
    height: auto;
    overflow: visible;
  }
  :global(.reduce-motion) .intro-panel {
    position: relative;
    inset: auto;
    opacity: 1;
    padding: 5rem 0;
  }
</style>
