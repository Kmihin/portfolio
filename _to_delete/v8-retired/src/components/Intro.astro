---
// Pinned intro: the particle cloud stays fixed while three text panels scroll past.
// Scroll progress morphs the cloud (sphere -> ring -> grid) and fades the panels.
interface Props {
  name: string;
  location: string;
  facts: { value: string; label: string }[];
}
const { name, location, facts } = Astro.props;
const [first, last] = name.split(" ");
---

<section id="intro" class="relative h-[400vh]">
  <div class="sticky top-0 h-screen overflow-hidden">
    <canvas id="particles" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>
    <div class="absolute inset-0 bg-gradient-to-t from-bg via-transparent to-bg/60 pointer-events-none" aria-hidden="true"></div>

    <!-- Panel 1: name -->
    <div class="intro-panel absolute inset-0 flex items-end" data-panel="0">
      <div class="max-w-6xl w-full mx-auto px-5 sm:px-8 pb-20">
        <p class="text-sm text-muted">{location}</p>
        <h1 class="mt-4 text-[14vw] sm:text-[9vw] lg:text-[8rem] leading-[0.92] font-bold tracking-tight">
          {first}<br /><span class="text-gold-soft">{last}</span>
        </h1>
        <p class="mt-8 text-lg sm:text-xl text-muted max-w-md">Full-stack developer. Scroll.</p>
      </div>
    </div>

    <!-- Panel 2: what I do -->
    <div class="intro-panel absolute inset-0 flex items-center" data-panel="1">
      <div class="max-w-6xl w-full mx-auto px-5 sm:px-8">
        <h2 class="text-3xl sm:text-5xl lg:text-6xl leading-[1.05] max-w-4xl">
          I build web applications, integrations and cloud infrastructure for companies that depend on them.
        </h2>
        <p class="mt-8 text-lg text-muted max-w-xl">.NET and Azure in production for years. React and Supabase for my own products. End to end: data model, backend, interface, deployment, support.</p>
      </div>
    </div>

    <!-- Panel 3: facts -->
    <div class="intro-panel absolute inset-0 flex items-center" data-panel="2">
      <dl class="max-w-6xl w-full mx-auto px-5 sm:px-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          facts.map((f) => (
            <div>
              <dd class="font-display text-5xl sm:text-6xl text-gold-soft">{f.value}</dd>
              <dt class="mt-3 text-muted leading-snug">{f.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>

    <p class="absolute bottom-6 left-1/2 -translate-x-1/2 text-xs text-muted tracking-wide" id="scroll-hint">Scroll</p>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { startSmoothScroll } from "../scripts/smooth-scroll";
  import { startParticles, setProgress } from "../scripts/particles";

  gsap.registerPlugin(ScrollTrigger);
  startSmoothScroll();

  const canvas = document.getElementById("particles") as HTMLCanvasElement;
  startParticles(canvas);

  const panels = gsap.utils.toArray<HTMLElement>(".intro-panel");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (reducedMotion) {
    // No scroll choreography: show the name panel only.
    gsap.set(panels[0], { opacity: 1 });
  } else {
    // One timeline over the whole 400vh section. Each panel fades in, holds, fades out.
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#intro",
        start: "top top",
        end: "bottom bottom",
        scrub: 0.6,
        onUpdate: (self) => setProgress(self.progress * 2),
      },
    });

    tl.fromTo(panels[0], { opacity: 1, y: 0 }, { opacity: 0, y: -60, duration: 1 }, 0.4)
      .fromTo(panels[1], { opacity: 0, y: 60 }, { opacity: 1, y: 0, duration: 1 }, 1.2)
      .to(panels[1], { opacity: 0, y: -60, duration: 1 }, 2.6)
      .fromTo(panels[2], { opacity: 0, y: 60 }, { opacity: 1, y: 0, duration: 1 }, 3.4)
      .to({}, { duration: 0.8 });

    gsap.to("#scroll-hint", { opacity: 0, scrollTrigger: { trigger: "#intro", start: "top top", end: "+=300", scrub: true } });
  }
</script>
