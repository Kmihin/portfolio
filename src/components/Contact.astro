---
// Contact and footer in one room at the end of the home page: a white marble envelope sealed in
// brass on the left (its seal lifts as the room arrives, sculptures.ts), everything else on the
// right: the contact heading, the email, the links, and under a hairline the footer line (name,
// place, year). The home page leaves out the site footer (Base footer={false}).
import { getCollection } from "astro:content";
import type { Copy } from "../lib/i18n";

interface Props {
  copy: Copy["contact"];
}
const { copy } = Astro.props;
const [profile] = await getCollection("profile");
const p = profile.data;
const githubHandle = p.github.replace(/^https?:\/\/(www\.)?/, "");
const year = new Date().getFullYear();
---

<section id="contact" class="room section-bg bg-contact relative pt-24 sm:pt-32 pb-14" data-theme="ivory">
  <div class="wrap room-grid contact-grid">
    <div class="contact-slot" data-sculpture="envelope" aria-hidden="true"></div>
    <div>
      <div class="reveal">
        <p class="section-number">05 <span class="section-line" aria-hidden="true"></span></p>
        <h2 class="room-title mt-5">{copy.title}<br /><em class="text-accent">{copy.titleEm}</em></h2>
        <p class="mt-6 text-lg text-muted max-w-[46ch] leading-relaxed">{copy.text}</p>
        <a href={`mailto:${p.email}`} class="link inline-block mt-10 font-display text-2xl sm:text-4xl break-all">{p.email}</a>
        <dl class="mt-10 grid gap-6 grid-cols-2 sm:grid-cols-4 text-sm">
          <div class="reveal-item">
            <dt class="text-muted">LinkedIn</dt>
            <dd class="mt-1"><a href={p.linkedin} class="link" rel="noopener">{copy.linkedin}</a></dd>
          </div>
          <div class="reveal-item">
            <dt class="text-muted">GitHub</dt>
            <dd class="mt-1"><a href={p.github} class="link" rel="noopener">{githubHandle}</a></dd>
          </div>
          <div class="reveal-item">
            <dt class="text-muted">{copy.cv}</dt>
            <dd class="mt-1"><a href={copy.cvFile} class="link" download>{copy.cvLink}</a></dd>
          </div>
          <div class="reveal-item">
            <dt class="text-muted">{copy.basedIn}</dt>
            <dd class="mt-1">{copy.location}</dd>
          </div>
        </dl>
      </div>

      <footer class="mt-16 pt-8 border-t border-line flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 text-sm">
        <p class="font-display text-xl tracking-[0.02em]">{p.name}</p>
        <p class="text-muted">{copy.location}</p>
        <p class="text-xs text-muted">{year}</p>
      </footer>
    </div>
  </div>
</section>

<style>
  .contact-slot {
    height: 40dvh;
  }
  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
      gap: 4rem;
      min-height: 86dvh;
    }
    .contact-slot {
      height: min(60dvh, 34vw);
    }
  }
</style>
