---
// The whole site is this one page, a journey through a 3D space (src/scripts/journey.ts): a screen
// that shatters, then a floating island per chapter. Every section names its stop (data-scene); the
// labels in the scene come from the content below (scene data, as JSON on the page). Pinned scenes
// (data-pin) hold the screen while their scroll plays out.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Facts from "../components/Facts.astro";
import ChapterHead from "../components/ChapterHead.astro";
import WorkList from "../components/WorkList.astro";
import type { WorkRow } from "../components/WorkList.astro";
import Expertise from "../components/Expertise.astro";
import Offer from "../components/Offer.astro";
import Closing from "../components/Closing.astro";
import Contact from "../components/Contact.astro";

const byId = (a: any, b: any) => a.data.id.localeCompare(b.data.id);
// Featured studies first, then the most recently active ("2022-2026" counts as 2026).
const lastYear = (w: any) => String(w.data.year).split("-").pop() ?? "";
const byFeaturedThenYear = (a: any, b: any) => Number(b.data.featured) - Number(a.data.featured) || lastYear(b).localeCompare(lastYear(a));
const skills = (await getCollection("skills")).sort(byId);
const services = (await getCollection("services")).sort(byId);
const work = [...(await getCollection("professional")).sort(byFeaturedThenYear), ...(await getCollection("projects")).sort(byFeaturedThenYear)];

const workRows: WorkRow[] = work.map((w) => ({
  slug: w.data.slug,
  title: w.data.title,
  summary: w.data.summary,
  kind: w.data.type === "project" ? "Own product" : "Professional",
  year: w.data.year,
  stack: w.data.stack.slice(0, 4),
}));

const about = [
  "I'm a full-stack developer with 5+ years of experience in modern web applications, cloud infrastructure and system integrations.",
  "I care about security as much as features: who can see and change what, roles and rights between companies, and data that moves safely between systems.",
  "I enjoy solving complex problems, working with new technologies and building solutions that make a real difference.",
];

const values = [
  { icon: "code" as const, label: "Clean code, best practices" },
  { icon: "lock" as const, label: "Security, roles & rights" },
  { icon: "cloud" as const, label: "Azure & DevOps" },
  { icon: "chart" as const, label: "Continuous improvement" },
];

const facts = [
  { value: "4+", label: "years building production software" },
  { value: "10k+", label: "documents a year through a platform I designed" },
  { value: "10+", label: "servers migrated to Azure" },
  { value: "3", label: "own products live" },
];
// What the scene shows: a cube per technology, a screen per case study, the figures over the
// pillars.
const sceneData = {
  skills: skills.map((s) => s.data.title),
  work: work.map((w) => w.data.label ?? w.data.title),
  facts,
};
---

<Base title="Full-stack developer" footer={false}>
  <script type="application/json" id="scene-data" is:inline set:html={JSON.stringify(sceneData)} />
  <Hero
    role="Full-stack developer"
    first="Kristjan"
    last="Mihin"
    tagline="Building business web applications, integrating systems and running reliable cloud infrastructure on .NET and Azure."
    stack={[".NET", "Azure", "TypeScript", "React", "SQL"]}
  />
  <About paragraphs={about} values={values} />
  <Facts facts={facts} />

  <section id="work" class="py-32 sm:py-44" data-scene="work" data-chapter-name="Work">
    <ChapterHead number="02" title="Selected" titleEm="work" lead="Systems built in employment, described without client names, and products of my own." />
    <div class="wrap">
      <div class="lg:max-w-[62%]">
        <WorkList rows={workRows} />
      </div>
    </div>
  </section>

  <section id="skills" class="py-32 sm:py-44" data-scene="skills" data-chapter-name="Expertise">
    <div>
      <ChapterHead number="03" title="Tech" titleEm="expertise" lead="The stack I work in every day, and what I have actually done with it." />
      <div class="wrap">
        <div class="lg:max-w-[62%]">
          <Expertise items={skills.map((s) => s.data)} />
        </div>
      </div>
    </div>
  </section>

  <section id="offer" class="py-32 sm:py-44" data-scene="offer" data-chapter-name="Offer">
    <ChapterHead number="04" title="What I" titleEm="offer" lead="From a focused integration to a complete system. Scope, availability and rates are agreed per project." />
    <div class="wrap">
      <div class="lg:max-w-[62%]">
        <Offer items={services.map((s) => s.data)} />
      </div>
    </div>
  </section>

  <Closing />
  <Contact />
</Base>
