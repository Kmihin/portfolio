---
// Contact and footer, the last scene: the camera ends at the board's I/O port (J1) on the right;
// on the left the invitation, the email as the main button, the links, and the footer line at the
// very bottom.
import { getCollection } from "astro:content";
const [profile] = await getCollection("profile");
const p = profile.data;
const githubHandle = p.github.replace(/^https?:\/\/(www\.)?/, "");
const year = new Date().getFullYear();
---

<section id="contact" class="scene flex-col justify-between pt-32 pb-8" data-scene="contact" data-chapter-name="Contact">
  <div class="wrap flex-1 flex items-center">
    <div class="reveal shade max-w-2xl">
      <p class="section-number">J1 / 05 <span class="section-line" aria-hidden="true"></span></p>
      <h2 class="mt-8 text-5xl sm:text-7xl lg:text-8xl" data-split>Let's <em>talk.</em></h2>
      <p class="mt-8 text-lg leading-relaxed max-w-[44ch] text-muted">Tell me what you are building. I reply within a day or two, in English or Slovenian. Scope and terms are agreed per project.</p>
      <a href={`mailto:${p.email}`} class="btn btn-primary mt-10">{p.email} <span class="arrow" aria-hidden="true">&rarr;</span></a>
      <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm">
        <li><a href={p.linkedin} class="link" rel="noopener">LinkedIn</a></li>
        <li><a href={p.github} class="link" rel="noopener">{githubHandle}</a></li>
        <li class="text-muted">{p.location}</li>
      </ul>
    </div>
  </div>

  <footer class="wrap pt-8 border-t border-line flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
    <p class="label text-ink">{p.name}</p>
    <p class="label">Full-stack developer, .NET and Azure</p>
    <p class="label">{year}</p>
  </footer>
</section>
