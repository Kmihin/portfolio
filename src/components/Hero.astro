---
// The opening screen, as in my mockup: role, the name (surname in brass), one line on what I do,
// "View my work" and "About me"; on the right my photo over a navy marble with gold veins
// (public/hero-art.webp, transparent where the paper was; its bottom edge is the diagonal cream cut
// into the About section below), the main stack listed on the marble, a scroll mark on the left.
// It is a little shorter than the screen, so About already shows below it. No particles here.
// Motion: the copy stages in on load (data-enter), the art settles in, and drifts a little slower
// than the page while the hero scrolls away (depth).
interface Props {
  role: string;
  first: string;
  last: string;
  tagline: string;
  stack: string[];
}
const { role, first, last, tagline, stack } = Astro.props;
---

<section id="home" class="hero relative isolate" data-theme="ivory">
  <img src="/hero-art.webp" alt={`${first} ${last}`} class="hero-art" width="2400" height="2093" fetchpriority="high" />
  <ul class="stack-list" aria-label="Main stack">
    {stack.map((s) => <li>{s}</li>)}
  </ul>

  <div class="wrap relative h-full">
    <div class="scroll-mark" aria-hidden="true">
      <span>01</span>
      <span class="scroll-line"></span>
      <span>Scroll</span>
    </div>
    <div class="hero-copy" data-enter>
      <p class="eyebrow">{role}</p>
      <h1 class="hero-name mt-5 lg:mt-7">
        <span class="block">{first}</span>
        <span class="block text-accent">{last}</span>
      </h1>
      <p class="mt-6 lg:mt-9 text-base sm:text-lg leading-relaxed max-w-[38ch]">{tagline}</p>
      <div class="mt-8 lg:mt-10 flex flex-wrap items-center gap-x-10 gap-y-4">
        <a href="#work" class="btn btn-primary">View my work <span class="arrow" aria-hidden="true">&rarr;</span></a>
        <a href="#about" class="link text-sm py-1">About me</a>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function startHero() {
    const hero = document.getElementById("home");
    const art = hero?.querySelector<HTMLElement>(".hero-art");
    if (!hero || !art || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    // Load: the art settles in from slightly larger, like a print laid on the paper.
    gsap.fromTo(art, { opacity: 0, scale: 1.04 }, { opacity: 1, scale: 1, duration: 1.6, ease: "expo.out", delay: 0.15 });
    // Scroll: the art moves up a little slower than the page.
    gsap.to(art, { yPercent: 8, ease: "none", scrollTrigger: { trigger: hero, start: "top top", end: "bottom top", scrub: 0.4 } });
  }

  document.addEventListener("astro:page-load", startHero);
</script>

<style>
  /* Wide screens: as tall as the art (about 86% of the screen), so About starts just below it. */
  .hero {
    height: min(100dvh, calc(min(62vw, 100dvh * 1.147) / 1.147));
    min-height: 40rem;
  }

  /* The hero art: photo and marble, anchored to the top right; about 60% of the width, never taller
     than the screen. */
  .hero-art {
    position: absolute;
    top: 0;
    right: 0;
    width: min(62vw, calc(100dvh * 1.147));
    height: auto;
    max-width: none;
    z-index: -1;
    pointer-events: none;
    transform-origin: 70% 30%;
  }

  /* The main stack, on the marble: ivory capitals beside a brass line. */
  .stack-list {
    display: none;
    position: absolute;
    top: 15%;
    right: 4.5vw;
    padding-left: 1.4rem;
    border-left: 1px solid var(--brass);
    color: #f1eadb;
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    line-height: 2;
  }

  .hero-copy {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 4rem;
  }
  .hero-name {
    font-size: clamp(3.75rem, 8.2vw, 8.75rem);
    font-weight: 600;
    font-variation-settings: "opsz" 36;
    line-height: 0.98;
    letter-spacing: -0.015em;
  }

  /* Scroll mark on the left: the number, a brass line with a dot running down it, the word. */
  .scroll-mark {
    display: none;
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .scroll-mark span:first-child,
  .scroll-mark span:last-child {
    writing-mode: vertical-rl;
  }
  .scroll-line {
    position: relative;
    width: 1px;
    height: 8.5rem;
    background: var(--accent);
    opacity: 0.8;
  }
  .scroll-line::after {
    content: "";
    position: absolute;
    left: -2.5px;
    top: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: scroll-dot 2.4s var(--ease-in-out) infinite;
  }
  @keyframes scroll-dot {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(8.2rem);
    }
  }

  @media (min-width: 1024px) {
    .stack-list {
      display: block;
    }
  }
  @media (min-width: 1280px) {
    .scroll-mark {
      display: flex;
    }
    .hero-copy {
      padding-left: 7rem;
    }
  }

  /* Below lg: the art sits at the top, the copy below it on the paper. */
  @media (max-width: 1023px) {
    .hero {
      height: auto;
      min-height: 100dvh;
    }
    .hero-art {
      top: 3.5rem;
      width: min(108vw, 46rem);
      right: -6vw;
    }
    .hero-copy {
      min-height: 100dvh;
      justify-content: flex-end;
      padding-top: 0;
      padding-bottom: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-line::after {
      animation: none;
    }
  }
</style>
