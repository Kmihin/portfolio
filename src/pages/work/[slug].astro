---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import CaseFeatures from "../../components/CaseFeatures.astro";

export async function getStaticPaths() {
  const byYear = (a: any, b: any) => b.data.year.localeCompare(a.data.year);
  const all = [...(await getCollection("professional")).sort(byYear), ...(await getCollection("projects")).sort(byYear)];
  return all.map((entry, i) => ({
    params: { slug: entry.data.slug },
    props: { entry, next: all[(i + 1) % all.length] },
  }));
}

const { entry, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const label = d.type === "project" ? "Side project" : "Professional";
---

<Base title={d.title} description={d.summary} progress>
  <article data-scene="detail">
    <header class="wrap pt-32 sm:pt-40 pb-14">
      <a href="/#work" class="label link">&larr; All work</a>
      <div class="mt-10 max-w-4xl shade" data-enter>
        <p class="label label-mark">{label}, {d.year}</p>
        <h1 class="mt-5 text-5xl sm:text-7xl leading-[0.98]" data-split>{d.title}</h1>
        {d.tagline && <p class="mt-5 text-2xl sm:text-3xl font-medium tracking-tight text-accent">{d.tagline}</p>}
        <p class="mt-6 text-lg sm:text-xl leading-relaxed max-w-[58ch] text-muted">{d.summary}</p>
      </div>
    </header>

    <div class="wrap">
      {
        d.cover && (
          <img
            src={d.cover.src}
            alt={d.cover.alt}
            width={d.cover.width}
            height={d.cover.height}
            fetchpriority="high"
            class="cover"
          />
        )
      }

      {d.features.length > 0 && <CaseFeatures features={d.features} note={d.featuresNote} />}

      <div class="mt-14 sm:mt-20 grid gap-12 lg:grid-cols-12">
        <!-- Sticky facts column -->
        <aside class="reveal lg:col-span-4 lg:sticky lg:top-28 lg:self-start">
          <dl class="glass p-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-1">
            <div>
              <dt class="label">Role</dt>
              <dd class="mt-2 leading-relaxed">{d.role}</dd>
            </div>
            <div>
              <dt class="label">Stack</dt>
              <dd class="mt-2 flex flex-wrap gap-2">
                {d.stack.map((s) => (
                  <span class="tag">{s}</span>
                ))}
              </dd>
            </div>
            {
              (d.links.repo || d.links.live) && (
                <div>
                  <dt class="label">Links</dt>
                  <dd class="mt-2 flex flex-col gap-1">
                    {d.links.live && (
                      <span>
                        <a href={d.links.live} class="link" rel="noopener">
                          {d.links.liveLabel ?? "Live site"}
                        </a>
                        {d.links.liveNote && <span class="block mt-1 text-xs text-muted">{d.links.liveNote}</span>}
                      </span>
                    )}
                    {d.links.repo && <a href={d.links.repo} class="link self-start" rel="noopener">Source on GitHub</a>}
                  </dd>
                </div>
              )
            }
          </dl>
        </aside>

        <div class="reveal prose-basic lg:col-span-7 lg:col-start-6 max-w-[64ch]">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <!-- Next case study -->
  <a href={`/work/${next.data.slug}`} class="next-link block mt-28 sm:mt-40">
    <div class="wrap py-14 sm:py-20 grid gap-4 sm:grid-cols-12 sm:items-end">
      <p class="label sm:col-span-3">Next</p>
      <h2 class="text-4xl sm:text-6xl leading-[1.02] sm:col-span-8" data-split>{next.data.title}</h2>
      <span class="hidden sm:block text-3xl sm:col-span-1 sm:text-right text-accent" aria-hidden="true"><span class="arrow">&rarr;</span></span>
    </div>
  </a>
</Base>

<style>
  /* The main image: full content width, its own proportions, a rounded hairline frame. */
  .cover {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line-strong);
    border-radius: 1rem;
  }
  .next-link {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.75);
    transition: background-color var(--duration-base) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .next-link:hover {
      background-color: var(--accent-soft);
    }
  }
</style>
