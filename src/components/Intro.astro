---
// Pinned intro on the ivory stone, 320vh tall. Three panels are driven by scroll:
//   0 - 24%   hero: role, the name (surname in brass), one line on what I do, "View my work" and
//             "About me"; on the right my photo over a navy marble with gold veins
//             (public/hero-art.webp, transparent where the paper was), the main stack listed on the
//             marble, a scroll mark on the left. No particles here.
//   24 - 58%  01 About me: two short paragraphs and the three parts of the work, with mountains in
//             the lower right (public/mountains.webp) and marble veins in the lower left
//             (public/marble-corner.webp, from a marble photo)
//   58 - 100% the four figures count up in brass while the particles form a turning globe; when the
//             pin ends the figures and the globe scroll away together (the stage is the cloud's anchor)
// The cloud's own timing is on the section's data-shapes ("scene@position"); data-faint="0" keeps it
// hidden up to data-faint-until.
// Motion purpose: storytelling (who -> what -> proof) with the scroll as the timeline.
interface Props {
  role: string;
  first: string;
  last: string;
  tagline: string;
  stack: string[];
  about: string[];
  pillars: { icon: "data" | "code" | "cloud"; title: string; text: string }[];
  facts: { value: string; label: string }[];
}
const { role, first, last, tagline, stack, about, pillars, facts } = Astro.props;

// Line icons for the three parts of the work (24px grid, drawn with the current colour).
const icons = {
  data: '<ellipse cx="12" cy="5.5" rx="7.5" ry="2.75"/><path d="M4.5 5.5v13c0 1.5 3.4 2.75 7.5 2.75s7.5-1.25 7.5-2.75v-13M4.5 12c0 1.5 3.4 2.75 7.5 2.75s7.5-1.25 7.5-2.75"/>',
  code: '<path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/>',
  cloud: '<path d="M7 18.5h10.5a4 4 0 0 0 .5-7.97A6 6 0 0 0 6.4 9.6 4.5 4.5 0 0 0 7 18.5z"/>',
};
---

<section id="intro" class="relative h-[320vh]" data-theme="ivory" data-shapes="galaxy@0>galaxy@0.52>globe@0.68>globe@1" data-faint="0" data-faint-until="0.54">
  <!-- Targets for the header links: Home is the opening screen, About the stretch where panel 2 shows. -->
  <span id="home" class="home-anchor" aria-hidden="true"></span>
  <span id="about" class="about-anchor" aria-hidden="true"></span>

  <div class="sticky top-0 h-dvh overflow-hidden" data-cloud data-cloud-fit="none">
    <!-- Panel 1: the hero -->
    <div class="intro-panel isolate absolute inset-0" data-panel="0">
      <img src="/hero-art.webp" alt={`${first} ${last}`} class="hero-art" width="1812" height="1580" fetchpriority="high" />
      <ul class="stack-list" aria-label="Main stack">
        {stack.map((s) => <li>{s}</li>)}
      </ul>

      <div class="wrap relative h-full">
        <div class="scroll-mark" aria-hidden="true">
          <span>01</span>
          <span class="scroll-line"></span>
          <span>Scroll</span>
        </div>
        <div class="hero-copy" data-enter>
          <p class="eyebrow">{role}</p>
          <h1 class="hero-name mt-5 lg:mt-7">
            <span class="block">{first}</span>
            <span class="block text-accent">{last}</span>
          </h1>
          <p class="mt-6 lg:mt-9 text-base sm:text-lg leading-relaxed max-w-[38ch]">{tagline}</p>
          <div class="mt-8 lg:mt-10 flex flex-wrap items-center gap-x-10 gap-y-4">
            <a href="#work" class="btn btn-primary">View my work <span class="arrow" aria-hidden="true">&rarr;</span></a>
            <a href="#about" class="link text-sm py-1">About me</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Panel 2: about me and the three parts of the work -->
    <div class="intro-panel isolate absolute inset-0 flex items-center" data-panel="1">
      <img src="/mountains.webp" alt="" class="mountains" width="782" height="488" loading="lazy" />
      <img src="/marble-corner.webp" alt="" class="marble-corner" width="1200" height="575" loading="lazy" />
      <div class="wrap relative grid gap-6 sm:gap-10 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-3">
          <p class="section-number">01 <span class="section-line" aria-hidden="true"></span></p>
          <h2 class="mt-4 sm:mt-6 text-5xl sm:text-7xl leading-[0.95]">About<br /><em class="text-accent">Me</em></h2>
        </div>
        <div class="lg:col-span-4 lg:pt-14 space-y-4 sm:space-y-5 text-base sm:text-lg leading-relaxed max-w-[44ch]">
          {about.map((line) => <p>{line}</p>)}
        </div>
        <dl class="values lg:col-span-5 lg:pt-14 grid grid-cols-3 gap-4 sm:gap-8">
          {
            pillars.map((pillar) => (
              <div>
                <svg class="value-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[pillar.icon]} />
                <dt class="mt-3 sm:mt-4 text-sm sm:text-base font-medium">{pillar.title}</dt>
                <dd class="mt-2 hidden sm:block text-sm text-muted leading-relaxed">{pillar.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <!-- Panel 3: facts; numbers follow the scroll -->
    <div class="intro-panel absolute inset-0 flex items-center" data-panel="2">
      <dl class="wrap grid gap-10 grid-cols-2 lg:grid-cols-4">
        {
          facts.map((f) => (
            <div class="shield">
              <dd class="font-display text-6xl sm:text-7xl lg:text-8xl text-accent leading-none" data-fact>{f.value}</dd>
              <dt class="mt-4 text-muted leading-snug max-w-[18ch]">{f.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // A tween that writes a counting number into an element ("10k+" keeps its suffix).
  function counter(el: HTMLElement) {
    const text = el.textContent ?? "";
    const match = text.match(/[\d.]+/);
    if (!match) return gsap.to({}, { duration: 1 });
    const target = Number(match[0]);
    const suffix = text.slice(match.index! + match[0].length);
    const state = { n: 0 };
    el.textContent = "0" + suffix;
    return gsap.to(state, { n: target, duration: 1, ease: "none", onUpdate: () => (el.textContent = Math.round(state.n) + suffix) });
  }

  function startIntro() {
    const intro = document.getElementById("intro");
    if (!intro) return;

    const panels = gsap.utils.toArray<HTMLElement>(".intro-panel");
    const facts = gsap.utils.toArray<HTMLElement>("[data-fact]");
    const art = intro.querySelector<HTMLElement>(".hero-art");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    gsap.set(panels[0], { opacity: 1 });
    if (reducedMotion) return;

    // Load: the art settles in from slightly larger, like a print laid on the paper.
    if (art) gsap.fromTo(art, { opacity: 0, scale: 1.04 }, { opacity: 1, scale: 1, duration: 1.6, ease: "expo.out", delay: 0.15 });

    // The scroll timeline: 1 unit = the pinned distance. Positions below are fractions of it.
    const tl = gsap.timeline({
      defaults: { ease: "none" },
      scrollTrigger: { trigger: intro, start: "top top", end: "bottom bottom", scrub: 0.4 },
    });

    // Panel 1 lifts away; the art drifts up a little slower than the text (depth).
    tl.to(panels[0], { opacity: 0, y: -90, duration: 0.14 }, 0.1);
    if (art) tl.to(art, { y: 50, duration: 0.14 }, 0.1);

    // Panel 2: enters, holds, leaves.
    tl.fromTo(panels[1], { opacity: 0, y: 70 }, { opacity: 1, y: 0, duration: 0.08 }, 0.25).to(panels[1], { opacity: 0, y: -70, duration: 0.08 }, 0.55);

    // Panel 3: enters, figures count with the scroll, stays, then leaves just before the end.
    tl.fromTo(panels[2], { opacity: 0, y: 70 }, { opacity: 1, y: 0, duration: 0.08 }, 0.62);
    facts.forEach((el, i) => tl.add(counter(el).duration(0.16), 0.64 + i * 0.03));
    tl.set({}, {}, 1);
  }

  document.addEventListener("astro:page-load", startIntro);
</script>

<style>
  /* Link targets inside the pinned section. The intro pins for 220vh; About is on show from about
     25% to 55% of that, so its target covers that stretch (the header marks it while it is mid-screen). */
  .home-anchor,
  .about-anchor {
    position: absolute;
    left: 0;
    width: 1px;
    pointer-events: none;
  }
  .home-anchor {
    top: 0;
    height: 95vh;
  }
  .about-anchor {
    top: 95vh;
    height: 76vh;
  }

  /* The hero art: photo and marble, anchored to the top right. On wide screens it takes about 60%
     of the width, never taller than the screen. */
  .hero-art {
    position: absolute;
    top: 0;
    right: 0;
    width: min(62vw, calc(100dvh * 1.147));
    height: auto;
    max-width: none;
    z-index: -1;
    pointer-events: none;
    transform-origin: 70% 30%;
  }

  /* The main stack, on the marble: ivory capitals beside a brass line. */
  .stack-list {
    display: none;
    position: absolute;
    top: 15%;
    right: 4.5vw;
    padding-left: 1.4rem;
    border-left: 1px solid var(--brass);
    color: #f1eadb;
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    line-height: 2;
  }

  .hero-copy {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 5rem;
  }
  .hero-name {
    font-size: clamp(3.75rem, 8.2vw, 8.75rem);
    font-weight: 600;
    font-variation-settings: "opsz" 36;
    line-height: 0.98;
    letter-spacing: -0.015em;
  }

  /* Scroll mark on the left: the number, a brass line with a dot running down it, the word. */
  .scroll-mark {
    display: none;
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .scroll-mark span:first-child,
  .scroll-mark span:last-child {
    writing-mode: vertical-rl;
  }
  .scroll-line {
    position: relative;
    width: 1px;
    height: 8.5rem;
    background: var(--accent);
    opacity: 0.8;
  }
  .scroll-line::after {
    content: "";
    position: absolute;
    left: -2.5px;
    top: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: scroll-dot 2.4s var(--ease-in-out) infinite;
  }
  @keyframes scroll-dot {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(8.2rem);
    }
  }

  @media (min-width: 1024px) {
    .stack-list {
      display: block;
    }
  }
  @media (min-width: 1280px) {
    .scroll-mark {
      display: flex;
    }
    .hero-copy {
      padding-left: 7rem;
    }
  }

  /* Below lg: the art sits at the top, the copy below it on the paper. */
  @media (max-width: 1023px) {
    .hero-art {
      top: 3.5rem;
      width: min(108vw, 46rem);
      right: -6vw;
    }
    .hero-copy {
      justify-content: flex-end;
      padding-top: 0;
      padding-bottom: 2.5rem;
    }
  }

  /* Panel 2 */
  .value-icon {
    width: 2rem;
    height: 2rem;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (min-width: 1024px) {
    .values {
      border-left: 1px solid var(--line);
      padding-left: 2.5rem;
    }
  }
  .mountains {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(36vw, 34rem);
    height: auto;
    z-index: -1;
    pointer-events: none;
  }
  /* Marble veins from the photo, rising out of the lower left corner. */
  .marble-corner {
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(38vw, 36rem);
    height: auto;
    z-index: -1;
    pointer-events: none;
  }
  @media (max-width: 1023px) {
    .marble-corner {
      display: none;
    }
    .mountains {
      width: 70vw;
      opacity: 0.6;
    }
  }

  /* The panels lie on top of each other; only the one on show takes clicks (its buttons and links). */
  .intro-panel {
    pointer-events: none;
  }
  .intro-panel :global(a),
  .intro-panel :global(button) {
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-line::after {
      animation: none;
    }
  }
  /* Reduced motion: no pin, the three panels simply follow each other. */
  :global(.reduce-motion) #intro {
    height: auto;
  }
  :global(.reduce-motion) #intro .sticky {
    position: static;
    height: auto;
    overflow: visible;
  }
  :global(.reduce-motion) .intro-panel {
    position: relative;
    inset: auto;
    opacity: 1;
    padding: 5rem 0;
  }
  :global(.reduce-motion) .intro-panel[data-panel="0"] {
    min-height: 100dvh;
    padding: 0;
  }
</style>
