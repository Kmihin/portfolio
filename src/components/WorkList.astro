---
// The selected work as a list of large rows, while the camera passes the work island, a screen per
// case study. Each row: number, title, summary, kind and year, stack tags, an arrow. The whole row
// opens the case study page; on hover the title turns blue and the row slides right.
export interface WorkRow {
  slug: string;
  title: string;
  summary: string;
  kind: string;
  year: string;
  stack: string[];
}
interface Props {
  rows: WorkRow[];
}
const { rows } = Astro.props;
---

<ol class="work-list reveal">
  {
    rows.map((row, i) => (
      <li class="reveal-item">
        <a href={`/work/${row.slug}`} class="work-row">
          <span class="label pt-3">{String(i + 1).padStart(2, "0")}</span>
          <span class="work-main">
            <span class="work-title font-display">{row.title}</span>
            <span class="mt-3 block text-muted leading-relaxed max-w-[56ch]">{row.summary}</span>
            <span class="mt-5 flex flex-wrap gap-2">
              {row.stack.map((s) => (
                <span class="tag">{s}</span>
              ))}
            </span>
          </span>
          <span class="work-meta label">
            {row.kind}
            <br />
            {row.year}
          </span>
          <span class="work-arrow" aria-hidden="true">
            <span class="arrow">&rarr;</span>
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .work-list {
    border-top: 1px solid var(--line);
  }
  .work-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem 1.25rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(to right, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.45));
    padding-left: 1rem;
    padding-right: 1rem;
    transition: transform 500ms var(--ease-out);
  }
  .work-title {
    display: block;
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    line-height: 1.05;
    transition: color var(--duration-base) ease;
  }
  .work-meta {
    grid-column: 2;
    line-height: 1.8;
  }
  .work-arrow {
    display: none;
    font-size: 1.5rem;
    color: var(--accent);
  }
  @media (min-width: 1024px) {
    .work-row {
      grid-template-columns: 4rem 1fr 11rem 2rem;
      gap: 2.5rem;
      padding: 2.75rem 0;
      align-items: start;
    }
    .work-meta {
      grid-column: auto;
      padding-top: 0.6rem;
    }
    .work-arrow {
      display: block;
      padding-top: 0.5rem;
      justify-self: end;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .work-row:hover {
      transform: translateX(0.75rem);
    }
    .work-row:hover .work-title {
      color: var(--accent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .work-row {
      transition: none;
    }
  }
</style>
