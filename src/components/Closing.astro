---
// Closing statement and contact details, back on the ivory paper (the footer below carries the mountain). On wide screens the particle cloud
// stays beside the text while the section scrolls (a sticky box on the left) and forms an envelope.
// The contact block carries my photo, treated to sit in the palette.
import { getCollection } from "astro:content";
const [profile] = await getCollection("profile");
const p = profile.data;
const githubHandle = p.github.replace(/^https?:\/\/(www\.)?/, "");
---

<section id="contact" class="relative py-28 sm:py-40" data-theme="ivory" data-shapes="mail@0.12">
  <div class="wrap grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5 lg:row-start-1" aria-hidden="true">
      <div class="h-56 lg:sticky lg:top-[20vh] lg:h-[60vh]" data-cloud></div>
    </div>

    <div class="lg:col-span-7 lg:col-start-6 lg:row-start-1">
      <div class="reveal shield">
        <h2 class="text-5xl sm:text-7xl leading-[1.0]" data-split>AI writes code fast. Experience decides what to build.</h2>
        <p class="mt-8 text-lg sm:text-xl text-muted leading-relaxed max-w-[52ch]">
          I use AI tools every day and they make me faster. They do not know your business, what breaks in production at night, or which shortcut costs you a year later.
        </p>
        <p class="mt-5 text-lg sm:text-xl text-muted leading-relaxed max-w-[52ch]">
          If a tool lets you build it in a hundred hours of your own time, someone who has shipped it before does it in a fraction of that, with fewer surprises and a system you can still run in five years.
        </p>
      </div>

      <div class="reveal mt-16 pt-10">
        <span class="rule mb-10" data-rule aria-hidden="true"></span>
        <div class="grid gap-8 sm:grid-cols-[11rem_1fr] sm:items-start">
          <img src="/portrait.jpg" alt={p.name} width="640" height="800" loading="lazy" class="portrait w-40 sm:w-full" />
          <div>
            <h3 class="text-3xl sm:text-4xl">Contact</h3>
            <p class="mt-4 text-muted max-w-[46ch] leading-relaxed">Tell me what you are building. I reply within a day or two, in English or Slovenian. Scope and terms are agreed per project.</p>
          </div>
        </div>
        <a href={`mailto:${p.email}`} class="link inline-block mt-10 font-display text-2xl sm:text-4xl break-all">{p.email}</a>
        <dl class="mt-12 grid gap-6 sm:grid-cols-3 text-sm">
          <div class="reveal-item">
            <dt class="text-muted">LinkedIn</dt>
            <dd class="mt-1"><a href={p.linkedin} class="link" rel="noopener">LinkedIn profile</a></dd>
          </div>
          <div class="reveal-item">
            <dt class="text-muted">GitHub</dt>
            <dd class="mt-1"><a href={p.github} class="link" rel="noopener">{githubHandle}</a></dd>
          </div>
          <div class="reveal-item">
            <dt class="text-muted">Based in</dt>
            <dd class="mt-1">{p.location}</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  /* The photo sits in the palette: monochrome, a little warmth, a brass line on top. */
  .portrait {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) sepia(0.25) contrast(1.05) brightness(0.92);
    border-top: 1px solid var(--accent);
  }
</style>
