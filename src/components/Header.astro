---
const links = [
  { href: "/work", label: "Work" },
  { href: "/services", label: "Services" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
const current = Astro.url.pathname;
---

<header class="fixed top-0 inset-x-0 z-20 bg-gradient-to-b from-bg/90 to-transparent">
  <nav class="max-w-6xl mx-auto px-5 sm:px-8 h-20 flex items-center justify-between">
    <a href="/" class="font-display font-semibold tracking-tight text-gold-soft">KM</a>
    <ul class="flex gap-5 sm:gap-8 text-sm">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={[
                "transition-colors hover:text-gold-soft",
                current.startsWith(l.href) ? "text-gold-soft" : "text-ink/80",
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
