---
// The selected work as a grid of white cards: the first two studies wide, the rest in three
// columns. Each card: number and kind in monospace, title, summary, the main stack as tags, an
// arrow in a circle. The whole card opens the case study page; on hover it lifts and its shadow
// turns blue.
export interface WorkCard {
  slug: string;
  title: string;
  summary: string;
  kind: string;
  year: string;
  stack: string[];
}
interface Props {
  cards: WorkCard[];
}
const { cards } = Astro.props;
---

<ol class="work-grid reveal">
  {
    cards.map((card, i) => (
      <li class:list={["reveal-item", i < 2 && "wide"]}>
        <a href={`/work/${card.slug}`} class="card work-card">
          <div class="flex items-center justify-between gap-4">
            <span class="label">{String(i + 1).padStart(2, "0")}</span>
            <span class="label">
              {card.kind} / {card.year}
            </span>
          </div>
          <h3 class="card-title mt-10 sm:mt-14">{card.title}</h3>
          <p class="mt-3 text-muted leading-relaxed max-w-[52ch]">{card.summary}</p>
          <div class="mt-auto pt-8 flex items-end justify-between gap-4">
            <ul class="flex flex-wrap gap-2">
              {card.stack.map((s) => (
                <li class="tag">{s}</li>
              ))}
            </ul>
            <span class="card-arrow" aria-hidden="true">
              <span class="arrow">&rarr;</span>
            </span>
          </div>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .work-grid {
    display: grid;
    gap: 1rem;
  }
  .work-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    transition:
      transform 500ms var(--ease-out),
      box-shadow 500ms var(--ease-out);
  }
  .card-title {
    font-size: clamp(1.5rem, 2.4vw, 2.1rem);
    line-height: 1.1;
  }
  .card-arrow {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 1.25rem;
    transition:
      background-color var(--duration-base) ease,
      color var(--duration-base) ease;
  }

  @media (min-width: 640px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .work-card {
      padding: 2rem;
    }
  }
  @media (min-width: 1024px) {
    .work-grid {
      grid-template-columns: repeat(6, 1fr);
    }
    .work-grid > li {
      grid-column: span 2;
    }
    .work-grid > li.wide {
      grid-column: span 3;
    }
    .wide .work-card {
      min-height: 22rem;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .work-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lift);
    }
    .work-card:hover .card-arrow {
      background: var(--accent);
      color: var(--accent-ink);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .work-card {
      transition: none;
    }
  }
</style>
