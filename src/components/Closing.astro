---
// Closing statement and contact details. The particles form a person behind it.
import { getCollection } from "astro:content";
const [profile] = await getCollection("profile");
const p = profile.data;
const githubHandle = p.github.replace(/^https?:\/\/(www\.)?/, "");
---

<section id="contact" class="relative py-32 sm:py-44" data-theme="plum" data-shapes="person" data-side="right">
  <div class="wrap grid gap-16 lg:grid-cols-12">
    <div class="lg:col-span-7 lg:col-start-6">
      <div class="reveal">
        <h2 class="text-4xl sm:text-6xl font-semibold leading-[1.0]" data-split>AI writes code fast. Experience decides what to build.</h2>
        <p class="mt-8 text-lg sm:text-xl text-muted leading-relaxed max-w-[52ch]">
          I use AI tools every day and they make me faster. They do not know your business, what breaks in production at night, or which shortcut costs you a year later.
        </p>
        <p class="mt-5 text-lg sm:text-xl text-muted leading-relaxed max-w-[52ch]">
          Ask yourself: if a tool lets you do it in a hundred hours of your own time, someone who has shipped it before does it in a fraction of that, with fewer surprises and a system you can still run in five years.
        </p>
      </div>

      <div class="reveal mt-16 border-t border-line pt-10">
        <h3 class="text-2xl sm:text-3xl font-semibold">Contact</h3>
        <p class="mt-3 text-muted max-w-[48ch] leading-relaxed">Tell me what you are building. I reply within a day or two, in English or Slovenian. Scope and terms are agreed per project.</p>
        <a href={`mailto:${p.email}`} class="link inline-block mt-8 font-display text-2xl sm:text-4xl font-medium break-all">{p.email}</a>
        <dl class="mt-10 grid gap-6 sm:grid-cols-3 text-sm">
          <div class="reveal-item">
            <dt class="text-muted">LinkedIn</dt>
            <dd class="mt-1"><a href={p.linkedin} class="link" rel="noopener">LinkedIn profile</a></dd>
          </div>
          <div class="reveal-item">
            <dt class="text-muted">GitHub</dt>
            <dd class="mt-1"><a href={p.github} class="link" rel="noopener">{githubHandle}</a></dd>
          </div>
          <div class="reveal-item">
            <dt class="text-muted">Based in</dt>
            <dd class="mt-1">{p.location}</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>
