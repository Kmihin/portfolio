---
// The rest of the work in named groups (professional work, own products). Each row links to its
// case study: the short name large on the left with kind and year under it, the summary and stack
// on the right. Hovering a row dims the others and slides its name to the right.
export interface WorkRow {
  slug: string;
  name: string;
  summary: string;
  year: string;
  stack: string[];
}
export interface WorkGroup {
  title: string;
  rows: WorkRow[];
}
interface Props {
  groups: WorkGroup[];
}
const { groups } = Astro.props;
---

<div class="work-groups">
  {
    groups.map((group) => (
      <div>
        <h3 class="label">{group.title}</h3>
        <ul class="work-list reveal">
          {group.rows.map((row) => (
            <li>
              <a href={`/work/${row.slug}`} class="work-row">
                <span>
                  <span class="work-name">{row.name}</span>
                  <span class="mt-2 block text-sm text-muted">{row.year}</span>
                </span>
                <span>
                  <span class="block text-muted leading-relaxed">{row.summary}</span>
                  <span class="mt-4 flex flex-wrap gap-2">
                    {row.stack.map((item) => (
                      <span class="tag">{item}</span>
                    ))}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .work-groups {
    display: grid;
    gap: 4.5rem;
  }
  .work-list {
    margin-top: 1rem;
    border-top: 1px solid var(--color-line);
  }
  .work-row {
    display: grid;
    gap: 1.25rem;
    padding-block: 2rem;
    transition: opacity 300ms ease;
  }
  .work-name {
    display: block;
    font-weight: 750;
    font-stretch: 112%;
    font-size: clamp(1.75rem, 3.2vw, 3rem);
    line-height: 1;
    letter-spacing: -0.03em;
    transition:
      translate 500ms var(--ease-out),
      color 300ms ease;
  }
  @media (min-width: 1024px) {
    .work-groups {
      max-width: 62%;
    }
    .work-row {
      grid-template-columns: 5fr 6fr;
      gap: 2.5rem;
      padding-block: 2.25rem;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .work-list:hover .work-row:not(:hover) {
      opacity: 0.4;
    }
    .work-row:hover .work-name {
      translate: 0.75rem 0;
      color: var(--color-accent-ink);
    }
  }
</style>
