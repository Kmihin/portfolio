---
// A slow ticker of monospace items between two hairlines (the technologies I work with). The list
// is repeated once so the loop is seamless; it stands still under reduced motion.
interface Props {
  items: string[];
}
const { items } = Astro.props;
const twice = [...items, ...items];
---

<div class="marquee" aria-label="Technologies">
  <ul class="marquee-track">
    {twice.map((item) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgba(6, 9, 15, 0.5);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    padding: 1.1rem 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    animation: ticker 60s linear infinite;
  }
  .marquee-track li {
    display: flex;
    align-items: center;
    white-space: nowrap;
  }
  .marquee-track li::after {
    content: "";
    width: 6px;
    height: 6px;
    margin: 0 2.25rem;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.7;
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .marquee:hover .marquee-track {
      animation-play-state: paused;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      padding-inline: 1.5rem;
    }
  }
</style>
